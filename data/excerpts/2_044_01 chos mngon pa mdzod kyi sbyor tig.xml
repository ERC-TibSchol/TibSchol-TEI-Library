:id="rel737" name="author-of" active="#person4016" passive="#work4760" type="positive"><desc>Evidence: <ptr target="#ex44012023-09-12"/></desc></relation><relation xml:id="rel254" name="student-of" active="#person4016" passive="#person4007" type="positive"><desc>Evidence: <ptr target="#ex44012023-09-12"/><ptr target="#ex44012024-1114"/></desc></relation><relation xml:id="rel1947" name="active-at" active="#person4016" passive="#place4382" type="positive"><desc>Evidence: <ptr target="#ex44012023-09-12"/></desc></relation><relation xml:id="rel1855" name="composed-at" active="#work4760" passive="#place4382" type="positive"><desc>Evidence: <ptr target="#ex44012023-09-12"/></desc></relation></listRelation></standOff><text>
      <body>
         <ab xml:space="preserve" type="cover_page">
         <seg type="excerpt" xml:id="ex44012023-10-11" status="reviewed" part="I" next="ex044012025-11-0716-26-57"><milestone unit="section" n="Cover page (1a)"/>
         <pb n="1a"/><lb n="1a1"/> phyi <lb n="1a2"/> dza <lb n="1a3"/> 30 <lb n="1a4"/>
            <rs type="work" ana="corpusmd:named_reference" ref="work:4760"><rs type="work" ana="corpusmd:named_reference" ref="work:3761">chos mngon pa mdzod</rs> kyi sbyor tik</rs> bzhugs s+ho || dge'o ||<note type="editorial">In dbu can</note></seg> 
         </ab>
         <ab xml:space="preserve" type="incipit">
         <seg type="shared" xml:id="ex044012025-11-0716-26-57" status="reviewed" part="M" next="ex44012024-1114"><milestone unit="section" n="Incipit (1b1)"/>
         <pb n="1b"/><lb n="1b1"/>|| bla ma dang 'jam pa'i dbyangs la phyag 'tshal lo || 
         <lg><l>zas gtsang sras su gyur nas lhar bcas kyi ||</l> <l>sdug bsngal ma lus bsal nas gdul bya rnams ||</l>  <l>thar pa'i <lb n="1b2"/> lam la 'god mdzad rkang 2 gtso ||</l> <l>thub dbang zhabs la gus pas legs par 'dud ||</l></lg> 
         <lg><l>rgyal phas lung bstan sangs rgyas 2 par grags || </l>
           <l>gsung rab kun la mkhyen pa mtha' yas pas ||</l>
            <l><lb n="1b3"/>thugs rjes bdag sogs gdul bya mtha' dag la ||</l> 
            <l>chos mngon legs gsung <rs type="person" ana="corpusmd:named_reference" ref="person:3758">dbyig gnyen</rs> zhabs la 'dud ||</l></lg> </seg>
            
            <seg type="excerpt" status="finalized" xml:id="ex44012024-1114" part="F"><lg><l><rs type="person" ana="corpusmd:named_reference" ref="person:4028">blo brtan</rs> nas bzung <rs type="person" ana="corpusmd:named_reference" ref="person:3977">nam mkha</rs>'i mtshan can dang ||</l> 
            <l>blo gros shes bya kun la dpag <lb n="1b4"/> med rgyas ||</l> 
            <l><rs type="person" ana="corpusmd:named_reference" ref="person:4007">bzang po</rs>'i mtshan can <rs type="person" ana="corpusmd:unnamed_reference" ref="person:4016">kho'o</rs>'i yongs 'dzin dang ||</l> 
            <l>brgyud pa'i bla ma rnams la phyag 'tshal nas ||</l>
            <l><rs type="work" ana="corpusmd:named_reference" ref="work:3761">chos mngon mdzod</rs> la sbyor Tig cung zad tsam ||</l> 
            <l><rs type="person" ana="corpusmd:unnamed_reference" ref="person:4016">bdag</rs> gi 'di dag brtsam par <lb n="1b5"/> mi nus na'ang || </l>
            <l><rs type="person" ana="corpusmd:named_reference" ref="person:4007">mchims ston bla ma</rs>'i bzhed pa ji bzhin dang || </l>
            <l>gsung las byon cing TI kar ma thebs rnams ||</l> 
            <l>legs par bshad kyi blo gros ldan pa dag ||</l> 
            <l>rnam dpyod byed cing ngo gdong bshad 'di ltos ¦</l> </lg>
            <lb n="1b6"/> sbyor ba dang ¦ rtsod spong dang ¦ lung 'dren rnaMs mangs na <expan>yi ge</expan> mangs pas 'jigs pas ¦ cung zad bsdus te bshad par bya'o || </seg>
            </ab>

