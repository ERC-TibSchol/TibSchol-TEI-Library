         <ab xml:space="preserve" type="colophon">
            <pb n="38a"/><lb n="38a3"/><seg type="excerpt" status="finalized" xml:id="ex44012023-09-12" ana="corpusmd:colophon"><milestone unit="section" n="Colophon (38a3-6)"/>
            <rs type="person" ana="corpusmd:named_reference" ref="person:4593">grub pa brnyes pa</rs> dang <rs type="person" ana="corpusmd:named_reference" ref="person:4593">mkhas btsun</rs> stong phrag du ma byon cing bzhugs pa'i gnas mchog <rs type="place" ana="corpusmd:named_reference" ref="place:4411">chos <lb n="38a4"/> grwa chen po dpal snar thang gi gtsug lag khang</rs> gi 'khris na yod pa'i <rs type="place" ana="corpusmd:named_reference" ref="place:4382">mthong smon dgu gling</rs> gi bzhi thog du | <rs type="person" ana="corpusmd:named_reference" ref="person:4007">mchims sku mched</rs> <anchor xml:id="a3"/>kyi zhabs kyi pad mo la spyi bos gtugs pa'i <rs type="person" ana="corpusmd:named_reference" ref="person:4016">shAkya'i btsun pa bsod nams <lb n="38a5"/> ye shes</rs> kyis legs par sbyar pa'o || ||
            <milestone unit="section" n="Post-colophon verse"/>'dis kyang sangs rgyas kyi bstan pa dang | 'gro ba mang po la phan par gyur cig | || 
            <milestone unit="section" n="Scribe colophon"/> <lb n="38a6"/> <expan>yi ge</expan> pa ni <rs type="person" ana="corpusmd:named_reference" ref="person:5770">rin chen bzang po</rs>'o || dge'o || bkra shis par gyur cig | ||</seg></ab>
