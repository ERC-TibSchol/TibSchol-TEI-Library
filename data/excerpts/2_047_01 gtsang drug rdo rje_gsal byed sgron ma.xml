         <pb n="12a"/><lb n="12a1"/><seg type="excerpt" xml:id="ex47012025-04-2915-45-39" status="finalized">
         <milestone unit="section" n="gangs pa and khyung"/>
         yang <note type="gloss"><rs type="person" ana="corpusmd:named_reference" ref="db:3810">gangs</rs> | <rs type="person" ana="corpusmd:named_reference" ref="db:3809">khyung</rs></note> <rs type="person" ana="corpusmd:unnamed_reference" ref="db:3809"><rs type="person" ana="corpusmd:unnamed_reference" ref="db:3810">kha 1</rs></rs> na re <expan>mtshan nyid</expan> kyi <expan>mtshan nyid</expan> mtshon bya mtshon pa'i rgyu mtshan <expan>yin no</expan> zer ba la | 
         de ltar na gtan tshigs kyi <lb n="12a2"/> <expan>mtshan nyid</expan> kyang bsgrub bya sgrub pa'i rgyu mtshan yin no byas pa la de'i tha snyad daM don ldog yin | 
         dang po ltar na gtan tshigs kyi tha snyad dang rnam grangs par 'gyur 2 pa ltar na phyogs chos khyab pa las ma 'das zhe na | 'dir yang mtshon bya mtshon pa'i rgyu mtshan gyi tha snyad dam don ldog la byed | dang po ltar na <expan>mtshan nyid</expan> kyi tha snyad dang rnam grangs par 'gyur 2 pa ltar <lb n="12a3"/> na don ldog chos 3 tshang ba las mang <expan>das so</expan> ||</seg> </ab>
