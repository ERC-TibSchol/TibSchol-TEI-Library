         <ab type="colophon">
            <pb n="40b"/><lb n="40b2"/><seg type="excerpt" xml:id="ex22032023-09-181" status="finalized" ana="corpusmd:colophon" next="ex22032024-10-1509-181">
            <milestone unit="section" n="1st Colophon (40b2-40b5)"/>
            <rs type="work" ana="corpusmd:named_reference" ref="work:4633"><rs type="work" ana="corpusmd:named_reference" ref="work:3693">sdud pa tshigs su bcad pa</rs>'i bshad sbyar</rs> <rs type="person" ana="corpusmd:named_reference" ref="person:5830"><choice><sic>slos</sic><corr>slob</corr></choice> dpon <expan>ye shes</expan> zhabs</rs> kyi dgongs pa la 'khrul pa spang pa'i phyir | <rs type="person" ana="corpusmd:named_reference" ref="person:5878">shag kya'i <choice><orig>rge'</orig><reg>dge</reg></choice> slong <expan>ye shes</expan> rgyal mtshan</rs> gyis sbyar ste'o || rdzogs so || × || × || <lb n="40b3"/> <rs type="place" ana="corpusmd:named_reference" ref="place:5656">rgyan dkar × phug</rs> du bris so || × ||</seg>
               
            <pb n="40b"/><seg type="excerpt" xml:id="ex22032024-10-1509-181" status="finalized" ana="corpusmd:colophon">
            <milestone unit="section" n="2nd scribe colophon (40b2-40b5)"/>
            <milestone n="1. Shes rab 'bar (ID:3807)" unit="section"/>
            ༄ <lg><l>|| shes rab pha rol tu phyin pa'i |</l> 
            <l>don la dmyigs shing 'khrul pa'i skyon</l> 
            <l>rnams sel cing sku ×'khrungs pa'i |</l> 
            <l><rs type="person" ana="corpusmd:named_reference" ref="person:3807">dam pa shes rab 'bar</rs> zhes grags |</l></lg>
            
            <milestone n="2. Ye shes rgyal (ID:5878)" unit="section"/>
            <lg><l>chu snod cig nas cig b+h+yo bzhin |</l> 
            <l>don dang tshig rnams rdzogs par yang<note type="editorial">Reading of the manuscript unclear, yang followed by an a-chung, or (m)nga' ?</note> |</l> 
            <l>'gro la phan phyir don rnams sgrogs ¦</l>
            <l><lb n="40b4"/> <choice><sic>gsregs</sic><corr>bsregs</corr></choice> don <rs type="person" ana="corpusmd:named_reference" ref="person:5878"><expan>ye shes</expan> rgyal</rs> zhes grags |</l></lg>
            
            <milestone n="3. Zhug ston (ID:6962)" unit="section"/>
            <lg><l><choice><sic>skyes</sic><corr>skye</corr></choice> shis 'jigs nas chos <choice><sic>rgyad</sic><corr>brgyad</corr></choice> bor || </l>
            <l>don tsam snang yang bye brag <choice><sic>rjed</sic><corr>brjed</corr></choice> |</l> 
            <l>dran pa bso phyir <rs type="place" ana="corpusmd:named_reference" ref="place:4335">chos 'khor bsam yas</rs> dag du <choice><reg>bris</reg><orig>b(r)is</orig></choice> |</l> 
            <l><rs type="person" ana="corpusmd:named_reference" ref="person:6962">dge' bshes zhug ston</rs> zhes byar grags ||</l></lg> 
            
            <milestone n="4. Shes rab thog po (ID:8401)" unit="section"/>
            <lg><l>'gro ba 'dul kyin bzhan don mdzad |</l> 
            <l><note type="editorial">This should constitute two lines of 7 syllables, but the faded portions do make it difficult to reconstruct the missing syllables</note>° thos mang sems <choice><orig>‹dang›</orig><reg>dang</reg></choice> sems kyi °°° me long lta ||</l> 
            <l><lb n="40b5"/> <rs type="person" ana="corpusmd:named_reference" ref="person:8401">shes rab thog po</rs> zhes su grags ||</l></lg><note type="editorial">This last verse appears to refer to the sponsor.</note>
