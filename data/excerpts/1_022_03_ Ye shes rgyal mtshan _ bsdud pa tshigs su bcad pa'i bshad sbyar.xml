   <standOff><listPerson><person xml:id="person3807"><persName type="main" xml:lang="bo-Latn-x-wylie">'bre shes rab 'bar</persName><persName xml:lang="bo">འབྲེ་ཤེས་རབ་འབར</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">'bre chen po</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">'dre chen po</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">'dre shes rab 'bar</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">'bri shes rab 'bar</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">shes rab bla ma</persName><birth notBefore="1040-01-01" notAfter="1100-12-31">after 1040 before 1100</birth><death notAfter="1200-12-31">before 1200</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P2274</idno><idno type="APIS">3807</idno><note type="comment">Further holy places associated to him are: Ze thang, Grwa thang and rMog po ([647FFPZR]: 545, based on [Q3KCZX7B]: 38).&#13;
Remembered for thirteen distinguished objects (such as royal insignia and religious articles), which could be objects of his clan ([4LDAV8UH]: 95.).</note></person><person xml:id="person5830"><persName type="main" xml:lang="bo-Latn-x-wylie">buddhaśrījñāna</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">sangs rgyas ye shes</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">slob dpon bud d+ha shrI dz+nyA na</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">kha che'i rigs kyi paN+Di ta chen po bud+d+ha shrI dz+nyA na</persName><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P9963</idno><idno type="APIS">5830</idno><note type="comment">Khro phu Lo tsA ba (ID:3878) reports that he was born in the Kathmandu Valley, his father being Kashmirian and his mother Indian ([K9NNDTDS]: 1392).</note></person><person xml:id="person5878"><persName type="main" xml:lang="bo-Latn-x-wylie">ye shes rgyal mtshan</persName><persName xml:lang="bo">ཡེ་ཤེས་རྒྱལ་མཚན</persName><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">5878</idno><note type="comment">According to the scribe colophon of instance (ID:4632), the author post-dates 'Bre shes rab 'bar (ID:3807).</note></person><person xml:id="person6962"><persName type="main" xml:lang="bo-Latn-x-wylie">zhug ston</persName><persName xml:lang="bo">ཞུག་སྟོན</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">dge' bshes zhug ston</persName><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">6962</idno></person><person xml:id="person8401"><persName type="main" xml:lang="bo-Latn-x-wylie">shes rab thog po</persName><persName xml:lang="bo">ཤེས་རབ་ཐོག་པོ</persName><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">8401</idno></person></listPerson><listBibl><bibl xml:id="work3693"><title type="main" xml:lang="bo-Latn-x-wylie">sañcayagāthā</title><title type="alt" xml:lang="bo-Latn-x-wylie">āryaprajñāpāramitāsañcayagāthā</title><title type="alt" xml:lang="bo-Latn-x-wylie">ārya-prajñāpāramitā-sañcayagāthā</title><title type="alt" xml:lang="bo-Latn-x-wylie">'phags pa shes rab kyi pha rol tu phyin pa sdud pa tshigs su bcad pa</title><title type="alt" xml:lang="bo-Latn-x-wylie">sdud pa tshigs su bcad pa</title><note type="isExtant">True</note><idno type="APIS">3693</idno></bibl><bibl xml:id="work4633"><title type="main" xml:lang="bo-Latn-x-wylie">bsdud pa tshigs su bcad pa'i bshad sbyar</title><title xml:lang="bo">བསྡུད་པ་ཚིགས་སུ་བཅད་པའི་བཤད་སྦྱར</title><title type="alt" xml:lang="bo-Latn-x-wylie">shAkya'i dge slong ye shes rgyal mtshan gyis mdzad pa'i bsdud pa tshigs su bcad pa'i bshad sbyar</title><title type="alt" xml:lang="bo-Latn-x-wylie">sdud pa tshigs su bcad pa'i bshad sbyar ye shes zhabs kyi dgongs pa 'khrul med</title><textLang mainLang="bo"/><author ref="person:5878">ye shes rgyal mtshan</author><note type="isExtant">True</note><note type="comment">The work was composed to refute mistakes pertaining to the interpretation of "Ye shes dpal," which likely refers to Buddhaśrījñāna (ID:5830), author of a Saṃcayagāthāpañjikā (ID:6964).</note><relatedItem type="commentaryOn" target="work:3693"/><idno type="APIS">4633</idno></bibl></listBibl><listPlace><place xml:id="place4335" type="S.MSTY"><placeName xml:lang="bo-Latn-x-wylie">bsam yas dgon pa</placeName><placeName xml:lang="bo">བསམ་ཡས་དགོན་པ</placeName><placeName type="alt" xml:lang="bo">chos 'khor bsam yas</placeName><placeName type="alt" xml:lang="bo">bsam yas</placeName><placeName type="alt" xml:lang="bo">samye</placeName><location><geo>29.326561016326725 91.50257349014284</geo></location><idno type="APIS">4335</idno></place><place xml:id="place5656"><placeName xml:lang="bo-Latn-x-wylie">rgyan dkar phug</placeName><placeName xml:lang="bo">རྒྱན་དཀར་ཕུག</placeName><placeName type="alt" xml:lang="bo">rgyan dkar khug</placeName><idno type="APIS">5656</idno></place></listPlace><listRelation><relation xml:id="rel1969" name="author-of" active="#person5878" passive="#work4633" type="positive"><desc>Evidence: <ptr target="#ex22032023-09-181"/><ptr target="#ex22032024-10-1509-181"/></desc></relation></listRelation></standOff><text>
