   <standOff><listPerson><person xml:id="person3725"><persName type="main" xml:lang="bo-Latn-x-wylie">candrakīrti</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">slob dpon zla ba grags pa</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">zla grags</persName><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P5782</idno><idno type="APIS">3725</idno></person><person xml:id="person4123"><persName type="main" xml:lang="bo-Latn-x-wylie">rgyud smad shes rab seng ge</persName><persName xml:lang="bo">རྒྱུད་སྨད་ཤེས་རབ་སེང་གེ</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">rgyud smad shes rab seng+ge</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">dka' bzhi pa shes rab seng ge</persName><birth notBefore="1383-01-01" notAfter="1383-12-31">1383</birth><death notBefore="1445-01-01" notAfter="1445-12-31">1445</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P2093</idno><idno type="APIS">4123</idno><note type="comment">[BKUHJCNA]: 764. He goes to Ri bo dge 'phel, Rta nag ri khud, and so forth and teaches phar, tshad, dbu ma, and so forth, increasing the number of mtshan nyid pa by more than thirty.&#13;
&#13;
Part of the lineage of the Vinayakārikā (ID:7858) according to the Fifth Dalai lama ([UGZJBIWM]: 382).</note></person><person xml:id="person4593"><persName type="main" xml:lang="bo-Latn-x-wylie">Anonymous</persName><persName xml:lang="bo">ཨཱནོཉམོཨུས</persName><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">4593</idno></person><person xml:id="person7860"><persName type="main" xml:lang="bo-Latn-x-wylie">dka' bzhi pa shes rab seng ge</persName><persName xml:lang="bo">དཀའ་བཞི་པ་ཤེས་རབ་སེང་གེ</persName><birth notAfter="1323-12-31">before 1323</birth><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">7860</idno><note type="comment">If one adopts 1333 as the date for his commentary on monastic discipline (ID:7861), and 1356 for that of bSam gtan bzang po, work (ID:4735), that refers to him in its colophon, this Shes rab seng ge must be different from rGyud smad shes rab seng ge (1383-1445) (ID:4123).</note></person></listPerson><listBibl><bibl xml:id="work3726"><title type="main" xml:lang="bo-Latn-x-wylie">madhyamakāvatāra</title><title type="alt" xml:lang="bo-Latn-x-wylie">dbu ma la 'jug pa</title><author ref="person:3725">candrakīrti</author><note type="isExtant">True</note><idno type="APIS">3726</idno></bibl><bibl xml:id="work5465"><title type="main" xml:lang="bo-Latn-x-wylie">dbu ma 'jug pa'i 'grel pa</title><title xml:lang="bo">དབུ་མ་འཇུག་པའི་འགྲེལ་པ</title><title type="alt" xml:lang="bo-Latn-x-wylie">dbu ma 'jug pa'i Tik+ka</title><textLang mainLang="bo"/><date type="composition" notBefore="1393-01-01" notAfter="1445-12-31">after 1393 before 1445</date><author ref="person:4123">rgyud smad shes rab seng ge</author><note type="isExtant">True</note><note type="comment">Composed at the request of unidentified "chen po dag."</note><relatedItem type="commentaryOn" target="work:3726"/><idno type="APIS">5465</idno></bibl><bibl xml:id="work7100"><title type="main" xml:lang="bo-Latn-x-wylie">rnam 'grel gyi TIkka</title><title xml:lang="bo">རྣམ་འགྲེལ་གྱི་ཊཱིཀཀ</title><textLang mainLang="bo"/><date type="composition" notBefore="1410-01-01" notAfter="1445-12-31">after 1410 before 1445</date><author ref="person:4123">rgyud smad shes rab seng ge</author><note type="isExtant">False</note><idno type="APIS">7100</idno></bibl><bibl xml:id="work7861"><title type="main" xml:lang="bo-Latn-x-wylie">'dul ba me tog phreng brgyud kyi sa bcad dang tshig le'ur byad pa'i de'i 'grel pa legs bshad rgya mtsho</title><title xml:lang="bo">འདུལ་བ་མེ་ཏོག་ཕྲེང་བརྒྱུད་ཀྱི་ས་བཅད་དང་ཚིག་ལེའུར་བྱད་པའི་དེའི་འགྲེལ་པ་ལེགས་བཤད་རྒྱ་མཚོ</title><textLang mainLang="bo"/><date type="composition" notBefore="1333-01-01" notAfter="1333-12-31">1333</date><author ref="person:7860">dka' bzhi pa shes rab seng ge</author><author ref="person:4123">rgyud smad shes rab seng ge</author><note type="isExtant">True</note><note type="comment">The work contains a summary on the Vinayakārikā (ID:7858) - one of the three currently extant - and a topical outline.&#13;
&#13;
Discussed in [N77QW83A]: 187, n. 156 and [UGZJBIWM]: 374.&#13;
&#13;
