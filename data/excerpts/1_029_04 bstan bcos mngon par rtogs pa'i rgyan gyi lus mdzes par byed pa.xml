      <pb n="94"/><lb n="47b7"/><seg type="excerpt" status="finalized" xml:id="ex29042023-09-112" ana="corpusmd:colophon">
      <milestone unit="section" n="Colophon (47b7-48b1) or (kha 265b7-266b1) (pp. 330-332)"/>
       <rs type="work" ana="corpusmd:named_reference" ref="db:4676"><rs type="work" ana="corpusmd:named_reference" ref="db:3706">bstan bcos mngon par rtogs pa'i rgyan</rs> gyi lus mdzes par byed pa'i rgyan ¦ legs par <choice><orig>{°}</orig><reg/></choice> bshad pa rin po che'i tshoms</rs> bsgrigs pa <pb n="48a"/><lb n="48a1"/> 'di ni ¦ lung gi sbyor ba mang po dang ¦ 'dod lugs sna tshogs dang ¦ dgag sgrub kyi rtsod lan mang po bris na sde snod la ma sbyangs pa'i gang zag gi go bar <lb n="48a2"/> dka' bas ¦ theg pa chen po'i sa lam gyi rim pa shin du gsal zhing rtogs sla ba ¦ tshig gis ma sgrib pa ¦ gsar bu thos pa chung bas bltas kyang blo la 'char bde ba cig <lb n="48a3"/> <rs type="work" ana="corpusmd:named_reference" ref="db:3706">mngon par rtogs pa'i rgyan gyi rtsa ba</rs> dang sbyar nas gzhung gi go ba longs pa la'ang phan par 'gyur zhing ¦ 'jug pa bde bar bris shig zhes ¦ bsnyen bkur ¦ me tog bzang po dang bcas <lb n="48a4"/> te ¦ dge ba'i bshes gnyen 'tsho ba'i rig byed la mkhas pa'i go 'phang thob pa ¦ <rs type="person" ana="corpusmd:named_reference" ref="db:4593">kun dga' rgyal mtshan</rs> gyis snga mo nas yang yang bskul ba las ¦ btang snyoms la re shig <lb n="48a5"/> 'gyangs par gyur na'ang ¦ <hi rendition="#Time">shing pho rta'i lo</hi> ¦ ljon shing dang ¦ sa gzhi rnaMs lo 'dab dang ¦ <hi rendition="#Time">rtswa ljang gi myu gu skyed pa'i dus</hi> su ¦ <rs type="person" ana="corpusmd:named_reference" ref="db:5781">bsod snyom pa rin chen rgyal mtshan dpal <lb n="48a6"/> bzang po</rs>s <expan>yi ger</expan> bkod pa 'dis kyang ¦ thub pa'i bstan pa dang ¦ sems can la phan bde 'byung par gyur cig | <rs type="work" ref="db:3706" ana="corpusmd:named_reference">mngon rtogs rgyan gyi rtsa ba</rs> <expan>thams cad</expan> la sbyar ba'i bshad pa byas na'ang ¦ <lb n="48a7"/> ha cang rgyas pas go dka' ba'i char gyur dgos nas ¦ lus rnam bzhag dang sbyar ba yin cing ¦ 'di tsam zhig legs par go na ¦ <rs type="work" ana="corpusmd:unnamed_reference" ref="db:7338">'grel pa Tï ka</rs> dang bcas pa bltas pas <pb n="48b"/><lb n="48b1"/> shes par <choice><orig>'gyu‹r›</orig><reg>'gyur</reg></choice> ba lags so || × maNG ga laM sid d+hi × shu b+haM || × dge 'o||</seg></ab>

         
