   <standOff><listPerson><person xml:id="person3725"><persName type="main" xml:lang="bo-Latn-x-wylie">candrakīrti</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">slob dpon zla ba grags pa</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">zla grags</persName><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P5782</idno><idno type="APIS">3725</idno></person><person xml:id="person3842"><persName type="main" xml:lang="bo-Latn-x-wylie">rma bya byang chub brtson 'grus</persName><persName xml:lang="bo">རྨ་བྱ་བྱང་ཆུབ་བརྩོན་འགྲུས</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">rma bya rtsod pa'i seng ge</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">rma bya</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">po tjɨj ˑjɨr</persName><birth notBefore="1085-01-01" notAfter="1130-12-31">after 1085 before 1130</birth><death notBefore="1185-01-01" notAfter="1185-12-31">1185</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P1982</idno><idno type="APIS">3842</idno><note type="comment">rMa bya's name is rendered in Tangut as Po tjɨj ˑjɨr, in which po tjɨj is a phonetic transcription of "bodhi" [=Tib. byang chub], whereas ˑjɨr means "diligence" [=Tib. brtson 'grus].</note></person><person xml:id="person3868"><persName type="main" xml:lang="bo-Latn-x-wylie">pa tshab nyi ma grags</persName><persName xml:lang="bo">པ་ཚབ་ཉི་མ་གྲགས</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">pa tshab lo tsA ba nyi ma grags pa</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">zhang pa tshab nyi ma grags</persName><birth notBefore="1055-01-01" notAfter="1055-12-31">1055</birth><death notBefore="1141-01-01">after 1141</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P5651</idno><idno type="APIS">3868</idno><note type="comment">Proposed dates: c. 1070-1145.</note></person><person xml:id="person3870"><persName type="main" xml:lang="bo-Latn-x-wylie">zhang thang sag pa ye shes 'byung gnas</persName><persName xml:lang="bo">ཞང་ཐང་སག་པ་ཡེ་ཤེས་འབྱུང་གནས</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">zhang 'byung gnas ye shes</persName><birth notBefore="1000-01-01" notAfter="1100-12-31">after 1000 before 1100</birth><death notBefore="1065-01-01" notAfter="1180-12-31">after 1065 before 1180</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P4455</idno><idno type="APIS">3870</idno><note type="comment">Lived between the second half of the eleventh century and the first half of the twelfth century ([CMTPPRKW]: 6)&#13;
One of the four spiritual sons of Pa tshab (ID:3868), along with gTsang pa Sar spos (ID:3871), rMa bya Byang chub ye shes (ID:6204), and Ngar/Dar Yon tan grags (ID:6211).</note></person><person xml:id="person7538"><persName type="main" xml:lang="bo-Latn-x-wylie">'brom dbang phyug grags</persName><persName xml:lang="bo">འབྲོམ་དབང་ཕྱུག་གྲགས</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">stod lung dbang phyug grags</persName><birth notBefore="1000-01-01">after 1000</birth><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P5652</idno><idno type="APIS">7538</idno><note type="comment">Possibly the same person as sTod lungs pa dBang phyug grags ([RCJ46BHM]: 340, n. 78).</note></person></listPerson><listBibl><bibl xml:id="work3724"><title type="main" xml:lang="bo-Latn-x-wylie">prasannapadā</title><title type="alt" xml:lang="bo-Latn-x-wylie">dbu ma rtsa ba'i 'grel pa tshig gsal ba zhes bya ba</title><title type="alt" xml:lang="bo-Latn-x-wylie">mūlamadhyamakavṛttiprasannapadānāma</title><author ref="person:3725">candrakīrti</author><note type="isExtant">True</note><idno type="APIS">3724</idno></bibl><bibl xml:id="work5528"><title type="main" xml:lang="bo-Latn-x-wylie">dbu ma tshig gsal gyi ti ka</title><title xml:lang="bo">དབུ་མ་ཚིག་གསལ་གྱི་ཏི་ཀ</title><textLang mainLang="bo"/><date type="composition" notBefore="1010-01-01" notAfter="1180-12-31">after 1010 before 1180</date><author ref="person:3870">zhang thang sag pa ye shes 'byung gnas</author><note type="isExtant">True</note><note type="comment">The work is presented in [CMTPPRKW] along with the unique manuscript (ID:7532). Commentary on the Prasannapadā (ID:3724), focusing on the first chapter, which takes up almost half of the entire commentary. &#13;
The author does not apply a systematic nested structure (sa bcad) to the work.&#13;
Edition of the manuscript in [Q5TFQTM8] (fols. 1a-26a3), [N8VI2328] (fols. 26a3-40b5), and [CMTPPRKW]: 15-28 (fols. 73a9-77a3).</note><relatedItem type="commentaryOn" target="work:3724"/><idno type="APIS">5528</idno></bibl><bibl xml:id="work6589"><title type="main" xml:lang="bo-Latn-x-wylie">bzhi brgya pa'i rnam bshad</title><title xml:lang="bo">བཞི་བརྒྱ་པའི་རྣམ་བཤད</title><textLang mainLang="bo"/><date type="composition" notBefore="1010-01-01" notAfter="1180-12-31">after 1010 before 1180</date><author ref="person:3870">zhang thang sag pa ye shes 'byung gnas</author><note type="isExtant">False</note><note type="comment">Listed in A khu ching Shes rab rgya mtsho's Tho yig ([5RXEUKD9]: 523, No. 11343: zhang thang sag pa ye shes 'byung gnas kyi bzhi brgya pa [...rnams kyi] rnam bshad).&#13;
Mentioned in [KM47ZZDJ]: 665.</note><idno type="APIS">6589</idno></bibl><bibl xml:id="work6590"><title type="main" xml:lang="bo-Latn-x-wylie">dbu ma 'jug pa'i rnam bshad</title><title xml:lang="bo">དབུ་མ་འཇུག་པའི་རྣམ་བཤད</title><textLang mainLang="bo"/><date type="composition" notBefore="1010-01-01" notAfter="1180-12-31">after 1010 before 1180</date><author ref="person:3870">zhang thang sag pa ye shes 'byung gnas</author><note type="isExtant">False</note><note type="comment">Listed in A khu ching Shes rab rgya mtsho's Tho yig ([5RXEUKD9]: 523, No. 11344: [zhang thang sag pa ye shes 'byung gnas kyi [...] dbu ma 'jug pa [...rnams kyi] rnam bshad).</note><idno type="APIS">6590</idno></bibl><bibl xml:id="work6591"><title type="main" xml:lang="bo-Latn-x-wylie">rin chen phreng ba'i rnam bshad</title><title xml:lang="bo">རིན་ཆེན་ཕྲེང་བའི་རྣམ་བཤད</title><textLang mainLang="bo"/><date type="composition" notBefore="1010-01-01" notAfter="1180-12-31">after 1010 before 1180</date><author ref="person:3870">zhang thang sag pa ye shes 'byung gnas</author><note type="isExtant">False</note><note type="comment">Listed in A khu ching Shes rab rgya mtsho's Tho yig ([5RXEUKD9]: 523, No. 11345: [zhang thang sag pa ye shes 'byung gnas kyi ...] rin chen phreng ba [...rnams kyi] rnam bshad).</note><idno type="APIS">6591</idno></bibl><bibl xml:id="work6592"><title type="main" xml:lang="bo-Latn-x-wylie">rigs pa drug cu pa'i rnam bshad</title><title xml:lang="bo">རིགས་པ་དྲུག་ཅུ་པའི་རྣམ་བཤད</title><textLang mainLang="bo"/><date type="composition" notBefore="1010-01-01" notAfter="1099-12-31">after 1010 before 1099</date><author ref="person:3870">zhang thang sag pa ye shes 'byung gnas</author><note type="isExtant">False</note><note type="comment">Listed in A khu ching Shes rab rgya mtsho's Tho yig ([5RXEUKD9]: 523, No. 11346: [zhang thang sag pa ye shes 'byung gnas kyi...] rigs pa drug cu pa [rnams kyi] rnam bshad).</note><idno type="APIS">6592</idno></bibl></listBibl><listPlace><place xml:id="pla