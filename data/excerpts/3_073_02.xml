            <ab>
               <gap reason="omitted"/><pb n="48b"/><lb n="48b7"/><seg type="excerpt" xml:id="ex730222024-11-08-13-28" status="finalized">
               <rs type="person" ana="corpusmd:named_reference" ref="db:5999">bu ston rin po che</rs>'i <expan>zhal snga</expan> nas mdzad <expan>pa'i</expan> <rs type="work" ana="corpusmd:named_reference" ref="db:7368">rnaM bshad lung gi snye ma</rs> dang | de nyid chan nyid kyis mdzad pa dang gsung sgros d+har+ma'i mtshan can gyis <expan>phyogs</expan> <expan>gcig</expan> tu bkod <expan>pa'i</expan> zin ris <expan>nas snangs</expan> rnaMs <expan>ba'i</expan> de nyid las khong du chud par bya bas 'dir ma bris <lb n="48b8"/> shing spyi don gyi gnas rnaMs na rgal zhing rtag pa bya ba mang du snang na yang | blo gsal 'jug pa bde <expan>ba'i</expan> don du re zhig 'dir bskus pa'o ||</seg>
               <gap reason="omitted"/></ab>
            
            <gap reason="omitted"/>
 <ab xml:space="preserve"><pb n="49a"/><lb n="49a5"/><seg type="excerpt" xml:id="ex73022023-09-261" status="finalized" ana="corpusmd:colophon">
         <milestone unit="section" n="Colophon (49a5-49a7)"/>
        <rs type="work" ana="corpusmd:named_reference" ref="db:5192"><rs type="work" ana="corpusmd:named_reference" ref="db:3706">shes rab kyi <expan>pha rol</expan> tu phyin pa'i man <expan>ngag gi</expan> <expan>bstan bcos</expan> mngon par <choice><corr>rtogs</corr><sic>stoGS</sic></choice> pa rgyan</rs> gyi <expan>dka' 'grel</expan> lung gi dpag bsam rgyas 'gyur gyi tshal</rs> zhes bya ba 'di ni | yongs 'dzin du mas nye bar bskyangs shing | khyad par du rang dang gzhan gyi grub <expan>pa'i</expan> mtha' rgya mtsho'i <expan>pha rol</expan> du phyin <lb n="49a6"/> pa <expan>rigs</expan> pa dang grol bar smra ba'i yongs ba bsaM gyis mi khyab pa la mnga' rnyes pas | <choice><corr>'chad</corr><sic>'tshad</sic></choice> pa dang rtsod pa dang | rtsoM <expan>pa'i</expan> tshul la zla dang bral ba <rs type="place" ana="corpusmd:named_reference" ref="db:5559">gangs can</rs> gyi bka' <expan>bzhi</expan> 'dzin pa <expan>gcig</expan> po <expan>nyid du</expan> nges pa | <rs type="person" ana="corpusmd:named_reference" ref="db:4074">brtson 'grus dpal</rs> gyi zhabs rdul spyi bos len cing | de nyid las chos 'di'i tshul la <expan><choice><corr>blo</corr><sic>slo</sic></choice>'i</expan> snang ba cung zad skyes pa | <rs type="person" ana="corpusmd:named_reference" ref="db:5193">shAkya' <choice><corr>btsun</corr><sic>bcun</sic></choice> pa <lb n="49a7"/> pa <expan>dkon mchog</expan> <expan>grags</expan></rs> kyis <rs type="place" ana="corpusmd:named_reference" ref="db:5733">ston <expan>pa'i</expan> rgyal tshab daM pa rnams kyi <expan>bzhugs</expan> gnas dpal <expan>sa skya</expan>'i chos gra dang nye ba'i sa</rs>r sbyar ba re shig <expan>rdzogs so</expan> ||</seg></ab>
         
