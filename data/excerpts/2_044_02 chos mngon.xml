               <lg><l>de ltar <rs type="person" ana="corpusmd:unnamed_reference" ref="person:6979">bdag</rs> gis <rs type="work" ana="corpusmd:named_reference" ref="work:4763"><rs type="work" ana="corpusmd:named_reference" ref="work:3761">chos mngon rin chen mdzod</rs></rs> || </l>
