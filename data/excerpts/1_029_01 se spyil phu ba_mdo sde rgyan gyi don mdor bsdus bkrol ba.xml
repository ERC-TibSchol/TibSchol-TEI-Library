756">asaṅga</author><note type="isExtant">True</note><idno type="APIS">3746</idno></bibl><bibl xml:id="work4669"><title type="main" xml:lang="bo-Latn-x-wylie">theg chen mdo sde rgyan gyi don mdor bsdus</title><title xml:lang="bo">ཐེག་ཆེན་མདོ་སྡེ་རྒྱན་གྱི་དོན་མདོར་བསྡུས</title><title type="alt" xml:lang="bo-Latn-x-wylie">spyi phu ba'i mdo sde rgyan gyi Ti k+ka</title><title type="alt" xml:lang="bo-Latn-x-wylie">se spyil phu ba chos kyi rgyal mtshan gyis mdzad pa'i theg chen mdo sde rgyan gyi don mdor bsdus bkrol ba</title><textLang mainLang="bo"/><date type="composition" notBefore="1141-01-01" notAfter="1189-12-31">after 1141 before 1189</date><author ref="person:3859">spyil phu pa chos kyi rgyal mtshan</author><note type="isExtant">True</note><note type="comment">The incipit refers to the composition of the work "in writing" (yi ger bri bar bya).</note><relatedItem type="commentaryOn" target="work:3746"/><idno type="APIS">4669</idno></bibl><bibl xml:id="work7338"><title type="main" xml:lang="bo-Latn-x-wylie">(undefined/undetermined)</title><idno type="APIS">7338</idno></bibl></listBibl><listPlace><place xml:id="place4373"><placeName xml:lang="bo-Latn-x-wylie">spyil phu dgon</placeName><placeName xml:lang="bo">སྤྱིལ་ཕུ་དགོན</placeName><placeName type="alt" xml:lang="bo">spyil bu</placeName><idno type="APIS">4373</idno></place><place xml:id="place7459"><placeName xml:lang="bo-Latn-x-wylie">'chad kha gsar ma</placeName><placeName xml:lang="bo">འཆད་ཁ་གསར་མ</placeName><placeName type="alt" xml:lang="bo">mal gro 'chad kha gsar ma</placeName><idno type="APIS">7459</idno></place></listPlace><listRelation><relation xml:id="rel7800" name="lineage-predecessor-of" active="#person3874" passive="#person3859" type="positive"/><relation xml:id="rel137" name="student-of" active="#person3859" passive="#person3874" type="positive"/><relation xml:id="rel4229" name="student-of" active="#person6841" passive="#person3859" type="positive"/><relation xml:id="rel4392" name="student-of" activ