         <rs type="work" ana="corpusmd:named_reference" ref="db:4669"><rs type="work" ana="corpusmd:named_reference" ref="db:3746">theg pa chen po mdo sde'i rgyan <lb edRef="inst:4668" n="61a6"/> gyi don mdor bsdus nas bkrol ba</rs></rs> | <rs type="person" ref="db:3859" ana="corpusmd:named_reference">shag kya'i dge slong chos kyi rgyal mtshan</rs> gyis sbyar ba'o | || |</seg></ab>
