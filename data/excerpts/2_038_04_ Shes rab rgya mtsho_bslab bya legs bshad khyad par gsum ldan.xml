         <lb n="52b6"/><seg type="excerpt" xml:id="ex38042023-09-18-114223" status="finalized" ana="corpusmd:colophon"><milestone unit="section" n="Colophon (52b6-53a3)"/>
         <l>sngon chad shes bya'i gnas la <lb n="52b7"/> sbyangs pa dang ||</l> 
         <l>lhag pa'i lha yi byin gyis brlab pa dang ||</l> 
         <l>bshes <choice><sic>nyen</sic><corr>gnyen</corr></choice> dam pas <expan>rjes su</expan> bzung ba'i mthus ||</l> 
         <l>shes bya phal cher 'bad pa chung dus shes ||</l> 
         <rs type="work" ana="corpusmd:named_reference" ref="db:4737">bslab bya'i gnas gtan la 'bebs par byed pa'i legs <pb n="53a"/><lb n="53a1"/> bshad <expan>khyad par</expan> gsum ldan</rs> zhes bya ba 'di ni ¦ dang por <rs type="person" ana="corpusmd:named_reference" ref="db:4009">'jam pa'i dbyangs <expan>dkon mchog</expan> rin chen<anchor xml:id="a1"/> </rs>gyis <note type="gloss">bka' drin gyis</note> legs par bskyangs shing ¦ bar du <rs type="person" ana="corpusmd:named_reference" ref="4593">mkhas pa'i dbang po <expan>gzhon nu</expan> rgyal mchog</rs> <expan>la sogs</expan> pa'i gsung gi smin <lb n="53a2"/> <choice><orig>×r</orig><reg>par</reg></choice> byas te ¦ mthar rnam dpyod kyis <expan>blo gros</expan> rtsa bshad kyi lung 'grel pa dang bcas <expan>rnam par</expan> dpyad pa la <choice><orig><expan>rten nas</expan></orig><reg>brten nas</reg></choice> ¦ dgag <choice><orig>bsgrub</orig><reg>sgrub</reg></choice> kyi <choice><orig>slab</orig><reg>bslab</reg></choice> pa'i gnas la <expan>blo gros</expan> kyi snang ba rgyas pa ¦ <rs type="person" ana="corpusmd:named_reference" ref="db:4009">shes rab rgya mtsho</rs>s × <rs type="person" ana="corpusmd:named_reference" ref="db:4312"><rs type="place" ana="corpusmd:named_reference" ref="db:5949">mnga' ris</rs> pa'i sde snod 'dzin pa <lb n="52a3"/> <choice><orig>(ch)en</orig><reg>chen</reg></choice> po <expan>dkon mchog</expan> blo bzang <anchor xml:id="a2"/></rs> <expan>la sogs</expan> pas bskul ba'i ngor ¦ <hi rendition="#Time">lcags mo <expan>phag gi</expan> lo</hi> ¦ <hi rendition="#Time">smal po'i zla ba'i bzang po'i tshes</hi> la <note type="editorial">If this Shes rab rgya mtsho is the third abbot of sNgor monastery the date would not be 1371 but 1431/2.</note> ¦ <rs type="place" ana="corpusmd:named_reference" ref="db:4411">dpal snar thang gi chos sde</rs>r rdzogs par sbyar ba'o || dge'o ||</seg>
         </ab>
         
