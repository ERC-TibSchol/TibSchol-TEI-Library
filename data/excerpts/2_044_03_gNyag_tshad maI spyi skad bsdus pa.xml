   <standOff><listPerson><person xml:id="person3745"><persName type="main" xml:lang="bo-Latn-x-wylie">atiśa dīpaṃkaraśrījñāna</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">slob dpon chen po dpal mar me mdzad ye shes</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">a ti sha</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">jo bo a ti sha</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">atīśa</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">atisha</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">jo bo rje</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">jo bo chen po</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">jo bo</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">dpal ldan a ti sha</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">paN+Di ta dI paM ka ra</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">ma hA paN+Di ta mar me mdzad ye shes</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">dpal mar me mdzad dpal ye shes zhabs</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">a d+hi sha</persName><birth notBefore="0972-01-01" notAfter="0982-12-31">after 972 before 982</birth><death notBefore="1054-01-01" notAfter="1055-12-31">after 1054 before 1055</death><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P3379</idno><idno type="APIS">3745</idno></person><person xml:id="person3773"><persName type="main" xml:lang="bo-Latn-x-wylie">dharmakīrti</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">chos kyi grags pa</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">chos grags</persName><birth notBefore="0550-01-01">after 550</birth><death notAfter="0660-12-31">before 660</death><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P6120</idno><idno type="APIS">3773</idno><note type="comment">The dates 600-660 were proposed in [C7GN3X2Q].&#13;
The mid-sixth century for his birth date was proposed in [KQVXHPVH].</note></person><person xml:id="person4593"><persName type="main" xml:lang="bo-Latn-x-wylie">Anonymous</persName><persName xml:lang="bo">ཨཱནོཉམོཨུས</persName><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">4593</idno></person><person xml:id="person5833"><persName type="main" xml:lang="bo-Latn-x-wylie">gnyag</persName><persName xml:lang="bo">གཉག</persName><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">5833</idno><note type="comment">The identity of "gNyag" (maybe a misspelling of gNyags) remains unknown.&#13;
It is suggested in [Z5WBK2VV]: 63 that he might be gNyags grags tshul, the abbot of bDe ba can in the teaching lineage of rGya 'ching ru ba (ID:4202).&#13;
[VSENG5SZ] identifies the author (apparently on the basis of the name alone) as gNyags chung Lo tsA ba (1013-1070) also named gNyag yon tan snying po, one of the four men who re-introduced monastic rules in Tibet. &#13;
There are other candidates with the name "gNyag" or "gNyags", but their views on epistemology cannot be compared with those of the present author. Comparison remains to be carried out with the views ascribed to gNyags ye shes 'bar (ID:4264) by several 12th-century authors.</note></person></listPerson><listBibl><bibl xml:id="work3772"><title type="main" xml:lang="bo-Latn-x-wylie">pramāṇavārttika</title><title type="alt" xml:lang="bo-Latn-x-wylie">pramāṇavārttikakārikā</title><title type="alt" xml:lang="bo-Latn-x-wylie">tshad ma rnam 'grel gyi tshig le'ur byas pa</title><title type="alt" xml:lang="bo-Latn-x-wylie">rnam 'grel</title><date type="composition" notBefore="0560-01-01" notAfter="0660-12-31">after 560 before 660</date><author ref="person:3773">dharmakīrti</author><note type="isExtant">True</note><idno type="APIS">3772</idno></bibl><bibl xml:id="work3774"><title type="main" xml:lang="bo-Latn-x-wylie">pramāṇaviniścaya</title><title type="alt" xml:lang="bo-Latn-x-wylie">tshad ma rnam par nges pa</title><title type="alt" xml:lang="bo-Latn-x-wylie">tshad ma rnam nges</title><date type="composition" notBefore="0560-01-01" notAfter="0660-12-31">after 560 before 660</date><author ref="person:3773">dharmakīrti</author><note type="isExtant">True</note><idno type="APIS">3774</idno></bibl><bibl xml:id="work3775"><title type="main" xml:lang="bo-Latn-x-wylie">sambandhaparīkṣā</title><title type="alt" xml:lang="bo-Latn-x-wylie">sambandhaparīkṣāprakaraṇa</title><title type="alt" xml:lang="bo-Latn-x-wylie">'brel pa brtag pa'i rab tu byed pa</title><date type="composition" notBefore="0560-01-01" notAfter="0660-12-31">after 560 before 660</date><author ref="person:3773">dharmakīrti</author><note type="isExtant">True</note><idno type="APIS">3775</idno></bibl><bibl xml:id="work3777"><title type="main" xml:lang="bo-Latn-x-wylie">vādanyāya</title><title type="alt" xml:lang="bo-Latn-x-wylie">vādanyāyanāmaprakaraṇa</title><title type="alt" xml:lang="bo-Latn-x-wylie">rtsod pa'i rigs pa zhes bya ba'i rab tu byed pa</title><title type="alt" xml:lang="bo-Latn-x-wylie">rtsod rigs</title><date type="composition" notBefore="0560-01-01" notAfter="0660-12-31">after 560 before 660</date><author ref="person:3773">dharmakīrti</author><note type="isExtant">True</note><idno type="APIS">3777</idno></bibl><bibl xml:id="work4765"><title type="main" xml:lang="bo-Latn-x-wylie">tshad ma'i spyi skad cung zad bsdus pa</title><title xml:lang="bo">ཚད་མའི་སྤྱི་སྐད་ཅུང་ཟད་བསྡུས་པ</title><title type="alt" xml:lang="bo-Latn-x-wylie">tshad ma'i spyi skad cung zad bsdus pa</title><title type="alt" xml:lang="bo-Latn-x-wylie">tshad ma'i spyi'i skad cung zad bsdus pa</title><textLang mainLang="bo"/><author ref="person:5833">gnyag</author><note type="isExtant">True</note><note type="comment">Short digest of epistemology. It does not contain any reference to the views of other Tibetan scholars apart from the mention of "contemporary logicians" (deng sang gyi rtog ge ba rnams) upholding a five-fold typology of non-valid cognition (ex2442025-02-0414-36-25).&#13;
The author cites the Madhyamakāvatāra (ID:3726) and the Satyadvayavibhaṅgakārikā (ID:5916) at the beginning of the work, and Atiśa's (ID:3745) Satyadvayāvatāra (ID:6040) at the end.&#13;
The epistemological system presented is akin to that of Phya pa (ID:3831), but with some features that find an echo in 13th-century works (in particular by bCom ldan ral gri (ID:4006)), whereas the only available instance (ID:4764) has several archaic features.&#13;
&#13;
Incipit: ex044032025-05-2118-25-44&#13;
Conclusion: ex44032023-07-2514-44-09&#13;
Colophon: ex44032023-07-2514-44-10&#13;
The colophon is followed by the list of Dharmakīrti's (ID:3773) seven treatises (ID:5553) organized into three major and four minor ones, compared respectively to the body and the limbs (ex044032025-05-2118-15-36).</note><idno type="APIS">4765</idno></bibl><bibl xml:id="work5589"><title type="main" xml:lang="bo-Latn-x-wylie">nyāyabindu</title><title type="alt" xml:lang="bo-Latn-x-wylie">rigs pa'i thigs pa zhes bya ba'i rab tu byed pa</title><title type="alt" xml:lang="bo-Latn-x-wylie">rigs thigs</title><title type="alt" xml:lang="bo-Latn-x-wylie">nyāyabindunāmaprakaraṇa</title><date type="composition" notBefore="0560-01-01" notAfter="0660-12-31">after 560 before 660</date><author ref="person:3773">dharmakīrti</author><note type="isExtant">True</note><note type="comment">A heavily annotated 11-folio dbu med manuscript of the Tibetan translation (fols. 1 and 2 missing) appears on pp. 629-648 of [WXWXCPPI]. In view of the signature "phyi zha 36" (on top of the first available folio), it was formerly part of the 'Bras spungs gnas bcu lha khang collection. [8H6M69W4] does not list any item with the signature "phyi zha 36."</note><idno type="APIS">5589</idno></bibl><bibl xml:id="work5831"><title type="main" xml:lang="bo-Latn-x-wylie">hetubindu</title><title type="alt" xml:lang="bo-Latn-x-wylie">hetubindunāmaprakaraṇa</title><title type="alt" xml:lang="bo-Latn-x-wylie">gtan tshigs kyi thigs pa zhes bya ba'i rab tu byed pa</title><title type="alt" xml:lang="bo-Latn-x-wylie">gtan tshigs thigs pa</title><date type="composition" notBefore="0560-01-01" notAfter="0660-12-31">after 560 before 660</date><author ref="person:3773">dharmakīrti</author><note type="isExtant">True</note><idno type="APIS">5831</idno></bibl><bibl xml:id="work6040"><title type="main" xml:lang="bo-Latn-x-wylie">satyadvayāvatāra</title><title type="alt" xml:lang="bo-Latn-x-wylie">bden pa gnyis la 'jug pa</title><date type="composition" notBefore="0982-01-01" notAfter="1054-12-31">after 982 before 1054</date><author ref="person:3745">atiśa dīpaṃkaraśrījñāna</author><note type="isExtant">True</note><idno type="APIS">6040</idno></bibl><bibl xml:id="work7068"><title type="main" xml:lang="bo-Latn-x-wylie">santānāntarasiddhi</title><title type="alt" xml:lang="bo-Latn-x-wylie">samtanantarasiddhi</title><title type="alt" xml:lang="bo-Latn-x-wylie">rgyud gzhan grub pa zhes bya ba'i rab tu byed pa</title><date type="composition" notBefore="0560-01-01" notAfter="0660-12-31">after 560 before 660</date><author ref="person:3773">dharmakīrti</author><note type="isExtant">True</note><idno type="APIS">7068</idno></bibl></listBibl><listRelation><relation xml:id="rel5825" name="quotes-with-name" active="#person5833" passive="#person3745" type="positive"><desc>Evidence: <ptr target="#ex44032023-07-2514-44-08"/></desc></relation><relation xml:id="rel1810" name="author-of" active="#person5833" passive="#work4765" type="positive"><desc>Evidence: <ptr target="#ex44032023-07-2514-44-10"/></desc></relation></listRelation></standOff><text>
