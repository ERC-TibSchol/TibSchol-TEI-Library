         <ab xml:space="preserve"><pb n="1b"/><lb n="81a3"/><seg type="excerpt" xml:id="ex66042024-09-1615-06-08" status="finalized" ana="corpusmd:colophon"> <milestone unit="section" n="Closing verses (81a3–81a4)"/>
            <lg><l>rnyed dka'i ° sky(es) dal 'byor mi lus kyi ||</l> <note type="editorial">The reading of skyes is tentative</note>
            <l>snying po len pa'i thabs kyi mchog gyur pa ||</l>
            <l>byang chub sems gnyis spyod tshul lung rigs la ||</l>
            <l>brten nas <lb n="81a4"/> <rs type="person" ana="corpusmd:named_reference" ref="db:4221">kyi ston 'jam pa'i dbyangs</rs> kyis bshad ||</l>
            <l>dge ba 'di yis 'gro kun sems bskyed de ||</l>
            <l>byang chub spyod pa'i tshul la legs zhugs pas ||</l>
            <l>tshogs gnyis rgyu chen rgya mtsho'i mthar son nas ||</l> 
            <l>sku gsum nor bu'i dpal la spyod par shog ||</l></lg></seg></ab>

         
         <ab xml:space="preserve" type="colophon">
            <pb n="1b"/><seg type="excerpt" xml:id="ex66042023-09-26-110525" status="finalized" ana="corpusmd:colophon">
            <milestone unit="section" n="Colophon (81a4–81a5)"/>
            <rs type="work" ana="corpusmd:named_reference" ref="db:5149"><rs type="work" ana="corpusmd:named_reference" ref="db:3727">byang chub sems dpa'i spyod pa la 'jug pa</rs>'i rgyan</rs> zhes bya ba 'di ni | <rs type="person" ana="corpusmd:named_reference" ref="db:3977"> byang chub <lb n="81a5"/> sems dpa' chen po 'phyims nam mkha' grags</rs> yab sras kyi byin <choice><orig>blab(s)</orig><reg>rlabs</reg></choice> zhugs pa'i <rs type="person" ana="corpusmd:named_reference" ref="db:4221">skyi ston 'jam pa'i dbyangs grags pa rgyal mtshan</rs> gyis | <rs type="person" ana="corpusmd:named_reference" ref="db:4593">'grel pa mkhan po</rs> lnga dang <rs type="person" ana="corpusmd:named_reference" ref="db:4593">gtsang pa</rs> lasogs pa'i legs bshad rnams blangs | nyes bshad rnams dor nas | <rs type="place" ana="corpusmd:named_reference" ref="db:5733">dpal ldan <expan>sa skya</expan>'i gtsug lag chen po</rs>r sbyar ba'o ||</seg>
         </ab>
          <ab xml:space="preserve" type="post_colophon"><pb n="1b"/><seg type="excerpt" xml:id="ex66042023-09-091209" status="finalized" ana="corpusmd:post_colophon">
         <milestone unit="section" n="Addition 1 (81a5): Ownership"/>
              <rs type="person" ana="corpusmd:named_reference" ref="db:5835"><expan>chos skyong</expan> dpal ldan</rs> gyi dpe'o
      </seg>
   </ab>
        <ab xml:space="preserve" type="post_colophon">
         <pb n="1b"/><seg type="excerpt" xml:id="ex6604_2026-01-2622-06-17" status="reviewed"><milestone unit="section" n="Addition 2 (81a6–81a7): lineage"/>
         <lb n="81a6"/> 'di'i nye rgyu 
        <rs type="person" ana="corpusmd:named_reference" ref="db:7966">thub pa</rs> |
         <rs type="person" ana="corpusmd:named_reference" ref="db:3747">'jam dbyangs</rs> | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:3743">zhi ba'i lha</rs> 
         <rs type="person" ana="corpusmd:named_reference" ref="db:5555">dze ta ri</rs> |   
         <rs type="person" ana="corpusmd:named_reference" ref="db:3802">su nya shri</rs> | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:3786">rngog lo</rs> | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:3805">zhang tshes</rs> | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:3876">nyang ran</rs> | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:4025">gtsang pa</rs> | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:3880">dpal ldan 'gro</rs> | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:3977">'chims chen po</rs><note type="editorial">Taken to refer to mChims nam mkha' grags (ID:3977)</note> | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:4052">skyo ston chen po</rs><note type="editorial">Taken to refer to sKyo ston sMon lam tshul khrims (ID:4052)</note> |
         <rs type="person" ana="corpusmd:named_reference" ref="db:4062">skyi ston shAg 'bum</rs> | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:4221">skyi ston 'jam pa'i dbyangs grags pa rgyal mtshan</rs> | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:4214">chos kyi rje thams cad mkhyen pa dpal ldan phyogs las rnam rgyal</rs>| 
      
      <rs type="person">skye dgu'i skyabs <lb n="81a7"/> rnams dam pa <choice><reg>'gyur</reg><orig>('gyur)</orig></choice> pa bsod nams chen po'i dpal</rs> gyis mngon par 'thob pa mkhan chen stan pa'i rgyal mtshan rnams s+ho ||</seg></ab>

