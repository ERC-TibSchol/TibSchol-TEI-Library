         <ab xml:space="preserve"><pb n="408"/><lb n="408,1"/><seg type="excerpt" xml:id="exXX0032026-02-1315-41-54" status="finalized"><rs type="person" ana="corpusmd:named_reference" ref="db:4025">gtsang pa gru gu</rs>s <lb n="408,2"/> <rs type="place" ana="corpusmd:named_reference" ref="db:4350">zha lu</rs>r bshad pa btsugs te |</seg><gap reason="omitted"/></ab>
         <ab xml:space="preserve">
         
            <pb n="408"/><lb n="408,5"/><seg type="excerpt" xml:id="exXX0032026-02-1314-58-13" status="finalized"><rs type="person" ana="corpusmd:named_reference" ref="db:3846">'u yug pa</rs>s <rs type="place" ana="corpusmd:named_reference" ref="db:5733">sa skya</rs>r <rs type="person" ana="corpusmd:named_reference" ref="db:3892">sa paN</rs> la <rs type="work" ana="corpusmd:named_reference" ref="db:3772">rnam 'grel</rs> gsan nas | <lb n="408,6"/> der bshad pa mdzad pas <rs type="person" ana="corpusmd:named_reference" ref="db:6624">mkhas pa chen po zhang mdo sde dpal</rs> la sogs pa'i <lb n="408,7"/> slob ma mang du byung zhing |</seg> 
         <pb n="408"/><seg type="shared" status="reviewed">ding sang gi bar du <rs type="work" ana="corpusmd:named_reference" ref="db:3772">rnam 'grel</rs> dar ba'ang paN chen dang khong rnam gnyis kyi drin yin | 
         gsang phu ba rnams kyang kho bo gzhon pa'i dus na rnam nges kyi bdag po mdzad pa las | ding sang ni rnam <lb n="408,10"/> 'grel bar gyur to ||</seg>
        
        <pb n="408"/><seg type="excerpt" xml:id="exXX0032026-02-1314-58-55" status="finalized"><rs type="person" ana="corpusmd:named_reference" ref="db:3904">bo dong rin rtse</rs>s <rs type="place" ana="corpusmd:named_reference" ref="db:5572">brag ram</rs> du bshad grwa btsugs | </seg><gap reason="omitted"/><pb n="408"/><seg type="excerpt" xml:id="exXX0032026-02-1314-58-22" status="finalized"><lb n="408,13"/><rs type="person" ana="corpusmd:named_reference" ref="db:3884">'jam dbyangs gsar ma</rs>s ni <rs type="place" ana="corpusmd:named_reference" ref="db:6049">skyang 'dur</rs> du bshad pa'i grwa btsugs <lb n="408,14"/> pas grwa pa mang du thon | 
         <rs type="person" ana="corpusmd:named_reference" ref="db:7759">kun mkhyen chos sku 'od zer</rs> zhes grags pa'ang <lb n="408,15"/> khong gi slob ma yin | 
         sku tshe'i smad la bshad grwa dang sgom grwa gnyis su <lb n="408,16"/> mdzad | skabs shed du <rs type="place" ana="corpusmd:named_reference" ref="db:7421">ri bo rtse lnga</rs>r yang byon nas slar bod du byon | 
         <lb n="408,17"/> <rs type="work" ana="corpusmd:unnamed_reference" ref="db:4575"><rs type="work" ana="corpusmd:unnamed_reference" ref="db:3711">phar phyin</rs></rs><note type="editorial">Tentative identification as being his "'Thad pa'i 'od 'bar" commentary on the Abhisamayālaṃkāravṛtti</note> dang <rs type="work" ana="corpusmd:named_reference" ref="db:5977"><rs type="work" ana="corpusmd:named_reference" ref="db:3774">rnam nges</rs> la TI ka</rs> yang mdzad snang |</seg><gap reason="omitted"/><pb n="409"/><lb n="409,2"/><seg type="excerpt" xml:id="exXX0032026-02-1315-33-04" status="finalized"><rs type="person" ana="corpusmd:named_reference" ref="db:4020">skyel nag grags seng</rs> la <rs type="person" ana="corpusmd:named_reference" ref="db:3977">'chims <lb n="409,3"/> chen mo</rs>s lkog tu zhal brda mdzad nas <rs type="place" ana="corpusmd:named_reference" ref="db:4411">snar thang</rs> du bshad nyan btsugs pas | <lb n="409,4"/> bka' gdams pa rnams de la ma dga' bas chad pa gcod zer ba la | <lb n="409,5"/> <rs type="person" ana="corpusmd:named_reference" ref="db:4020">skyel nag</rs> gis <rs type="person" ana="corpusmd:named_reference" ref="db:3977">'chims chen mo</rs> la 'dir bshad pa rang mi tshugs pa 'dra zhus <lb n="409,6"/> pas | <rs type="person" ana="corpusmd:named_reference" ref="db:3977">'chims</rs> kyi zhal nas | ngas ja mang du byin gyis | chad pa'i <lb n="409,7"/> ja lan gsum tsam du bskol la | mang ja gsum pa'i steng du chad pa ni <lb n="409,8"/> phul yod | da bgro gleng byed zer ba gyis la bgro gleng gyis zhes lkog tu <lb n="409,9"/> zhal brda mdzad | de ltar byas pas bshad pa yang legs par tshugs te | <lb n="409,10"/> <rs type="person" ana="corpusmd:named_reference" ref="db:4064">skyi ston grags 'bum</rs> dang | <rs type="person" ana="corpusmd:named_reference" ref="db:4018">chu mig pa seng ge dpal</rs> la sogs pa mkhas <lb n="409,11"/> pa mang du thon |</seg> 
