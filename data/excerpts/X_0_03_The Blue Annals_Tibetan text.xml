         <rs type="person" ana="corpusmd:named_reference" ref="db:3904">chos rje rin chen rtse mo</rs> la mngon pa gong 'og <rs type="work" ana="corpusmd:named_reference" ref="db:3774">tshad ma rnam</rs> <lb n="817,14"/> <rs type="work" ana="corpusmd:named_reference" ref="db:3774">nges</rs> | <rs type="work" ana="corpusmd:named_reference" ref="db:7338">shes rab 'grel chung</rs> gsan zhing | 'chad rtsod rtsom gsum la <lb n="817,15"/> 'gran zla med pa'i grags pa thob |</seg><gap reason="omitted"/></ab>
