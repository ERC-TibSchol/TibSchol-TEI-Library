         <ab xml:space="preserve"><gap reason="omitted"/> <pb n="917"/><lb n="917,9"/><seg type="excerpt" xml:id="exXX0032026-02-1619-32-22" status="finalized">yang <rs type="person" ana="corpusmd:named_reference" ref="db:3887">gnyal zhig</rs> <lb n="917,10"/> bu dgu'i ya gyal du gyur pa <rs type="person" ana="corpusmd:named_reference" ref="db:3904">bo dong rin po che rin chen rtse mo</rs>s kyang bla ma <lb n="917,11"/> se mo che ba la dus kyi 'khor lo'i bshad pa dang man ngag thams cad mnos <lb n="917,12"/> te |</seg><gap reason="omitted"/><pb n="917"/><lb n="917,18"/><seg type="excerpt" xml:id="exXX0032026-02-1619-32-11" status="finalized"><rs type="person" ana="corpusmd:named_reference" ref="db:3904">bo dong rin po che</rs>'i slob ma <rs type="person" ana="corpusmd:named_reference" ref="db:4127">stag sde ba seng ge rgyal mtshan</rs> ni | <rs type="place" ana="corpusmd:named_reference" ref="db:8145">pha ri lung</rs> du chu pho spre'u la 'khrungs | <rs type="person" ana="corpusmd:named_reference" ref="db:3904">bo dong <pb n="918"/><lb n="918,1"/> rin po che</rs> la phar tshad mngon gsum dang | khyad par du dus 'khor dbang bshad pa man ngag dang bcas pa gsan |</seg><gap reason="omitted"/><lb n="918,10"/><seg type="excerpt" xml:id="exXX0032026-02-1619-32-10" status="finalized">de la spyang lungs shar kha'i bong ra zhes par sku 'khrungs <lb n="918,11"/> pa'i <rs type="person" ana="corpusmd:named_reference" ref="db:6646">shong ston rdo rje rgyal mtshan</rs> gyis <rs type="person" ana="corpusmd:named_reference" ref="db:4127">stag sde ba</rs> la tshad ma la sogs pa'i <lb n="918,12"/> bstan bcos mang po la slob gnyer mdzad |</seg><gap reason="omitted"/></ab>
