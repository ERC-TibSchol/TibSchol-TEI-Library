         <ab xml:space="preserve">

            <gap reason="omitted"/><pb n="404"/><lb n="404,3"/><seg type="excerpt" xml:id="exXX0032025-06-1616-03-07" status="finalized"><rs type="person" ana="corpusmd:unnamed_reference" ref="db:3806">bdag nyid chen po de</rs>'i sku tshe'i mthar <lb n="404,4"/> gtugs pa na | <rs type="person" ana="corpusmd:named_reference" ref="db:3831">slob dpon phywa pa</rs>s 'bad pas gsan nas <rs type="work" ana="corpusmd:named_reference" ref="db:6597"><rs type="work" ana="corpusmd:named_reference" ref="db:3711">'grel chung</rs> gi <lb n="404,5"/> TI ka che ba</rs> zhig mdzad de | de'i rjes su 'brang ba dang bcas pa rnams ni <lb n="404,6"/> <rs type="person" ana="corpusmd:named_reference" ref="db:3807">'bre</rs> <rs type="person" ana="corpusmd:named_reference" ref="db:3816">ar</rs> gyi lugs las tha dad pa yin no ||</seg>
         
