			<pb n="160a4"/><seg type="shared" status="reviewed">	
			<lg><l><lb n="160a6"/> 'di' la ma tshang lhag pa dang ||</l> 
			<l>'khrul pa'i skyon dag snang na yang ||</l> 
			<l>so so skye bo yin na yang ||</l> 
			<l>mkhas pa rnams gyis bzod pa'i rigs ||</l></lg>×
			<lg><l>'di' dang mi ldan rtsa ba'i don ||</l> 
				<l>'chad par byed pa kha cig ni ||</l>
				<l>mun khung lag nom byed pa bzhi ||</l>
			<l>'di don legs par shes <lb n="160a7"/> mi 'gyur ||</l></lg></seg>
			
