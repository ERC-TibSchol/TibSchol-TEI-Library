         <ab xml:space="preserve">
         <lb n="187b5"/><seg type="excerpt" xml:id="exX10_2025-02-0609-38-542" status="finalized" part="I" next="exX10_2025-02-0609-38-54">
         <lg><l>'gro ba'i bla ma <lb n="187b6"/> rgyal dang rgyal sras <rs type="person" ana="corpusmd:named_reference" ref="db:3720">byams mgon klu sgrub</rs>  rjes 'brang bcas ||</l>
         <l><rs type="person" ana="corpusmd:named_reference" ref="db:3756">thogs med</rs> <rs type="person" ana="corpusmd:named_reference" ref="db:3758">dbyig gnyen</rs> <rs type="person" ana="corpusmd:named_reference" ref="db:3771">phyogs kyi glang po</rs> <rs type="person" ana="corpusmd:named_reference" ref="db:3773">chos kyi grags pa</rs> bzhed pa'i gzhung ||</l>
         <l><rs type="work" ana="corpusmd:named_reference" ref="db:5588">rnam 'grel rgyan</rs> dang <rs type="work" ana="corpusmd:named_reference" ref="db:5594">rnam nges chos mchog</rs> bde byed zla ba'i lugs <pb n="188a"/><lb n="188a1"/> 'dzin cing ||</l> 
         <l>mu stegs byed pa'i lta ngan kun sel gzhung 'di <rs type="person" ana="corpusmd:named_reference" ref="db:4006">dpal ldan ral gri</rs>s bkod ||</l></lg></seg>
         </ab>
         <gap reason="omitted"/>
         <ab xml:space="preserve" type="colophon">
         <lb n="188a5"/><seg type="excerpt" xml:id="exX10_2025-02-0609-38-54" status="finalized" ana="corpusmd:colophon" part="M" next="exX10_2025-11-1013-12-45">
            <milestone n="Colophon (188a5-188a6)" unit="section"/>
            <rs type="work" ana="corpusmd:named_reference" ref="db:5526">tshad ma'i bstan bcos gzhan phyogs zil gnon rigs pa'i mtshon cha</rs> zhes bya ba | ming gzhan <rs type="work" ana="corpusmd:named_reference" ref="db:5526">grub mtha' sna tshogs bshad pa bde bar gshegs pa'i bstan pa'i sgron me</rs> 'di ni sngon gyi <rs type="person" ana="corpusmd:unnamed_reference" ref="4593">slob dpon</rs> <lb n="188a6"/> dag gi gzhung lugs du ma mthong zhing thos te de dag gsal la ma 'dres par rigs pa dang grol bar smra ba'i spobs pa can <rs type="person" ana="corpusmd:named_reference" ref="db:4006">yul dbus kyi btsun pa rigs pa'i ral gri</rs>s bkod do ||</seg>
      </ab>

         <ab xml:space="preserve"><seg type="shared" xml:id="exX10_2025-11-1013-12-45" status="reviewed" part="F">'dis 'gro ba ma lus pa'i ma rig pa'i mun pa <pb n="188b"/><lb n="188b1"/> sel bar gyur cig | sa ma pa ta | 
         bstan bcos 'di la mdo sde nyi shu rtsa gsum bstan bcos brgyad cu rtsa lnga ste mdo bstan bcos mi gcig pa brgya rtsa brgyad kyi lung rigs bzhugs so || mu stegs kyi gzhung rnams khong <lb n="198b2"/> nyid bstan bcos du yod mi shes par snang ngo || lung tshig mi mthun pa rnams ni 'gyur du ma yod do || dge'o ||</seg></ab>
