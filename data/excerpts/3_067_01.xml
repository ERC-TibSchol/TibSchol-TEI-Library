   <standOff><listPerson><person xml:id="person3743"><persName type="main" xml:lang="bo-Latn-x-wylie">śāntideva</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">slob dpon zhi ba'i lha</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">rgyal sras zhi ba lha</persName><birth notBefore="0600-01-01">after 600</birth><death notAfter="0800-12-31">before 800</death><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P6161</idno><idno type="APIS">3743</idno></person><person xml:id="person3747"><persName type="main" xml:lang="bo-Latn-x-wylie">maitreya</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">'phags pa byams pa</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">byams pa mgon po</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">maitreyanātha</persName><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P6118</idno><idno type="APIS">3747</idno><note type="comment">Future Buddha held as the author of the works that come to be designated as the "Five Jewels of Maitreya" (ID:6167).</note></person><person xml:id="person3756"><persName type="main" xml:lang="bo-Latn-x-wylie">asaṅga</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">slob dpon thogs med</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">thogs myed</persName><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P6117</idno><idno type="APIS">3756</idno></person><person xml:id="person4068"><persName type="main" xml:lang="bo-Latn-x-wylie">jo nang lo tsA ba blo gros dpal bzang</persName><persName xml:lang="bo">ཇོ་ནང་ལོ་ཙཱ་བ་བློ་གྲོས་དཔལ་བཟང</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">jo nang lo tsA ba blo gros dpal</persName><birth notBefore="1299-01-01" notAfter="1299-12-31">1299</birth><death notBefore="1353-01-01" notAfter="1364-12-31">after 1353 before 1364</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P153</idno><idno type="APIS">4068</idno><note type="comment">Dates: 1299-1353 or 1300-1364 ([BAQ9MH4T]: 172).</note></person><person xml:id="person4069"><persName type="main" xml:lang="bo-Latn-x-wylie">rin chen rgyal mtshan</persName><persName xml:lang="bo">རིན་ཆེན་རྒྱལ་མཚན</persName><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">4069</idno></person><person xml:id="person4097"><persName type="main" xml:lang="bo-Latn-x-wylie">dpang lo tsA ba blo gros brtan pa</persName><persName xml:lang="bo">དཔང་ལོ་ཙཱ་བ་བློ་གྲོས་བརྟན་པ</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">dpang blo gros brtan pa</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">btsun chung lu gu</persName><birth notBefore="1276-01-01" notAfter="1276-12-31">1276</birth><death notBefore="1342-01-01" notAfter="1342-12-31">1342</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P2085</idno><idno type="APIS">4097</idno><note type="comment">A short biography from the Shel dkar chos 'byung is translated in [N35FPQ6L]: 62-70. It gives a fire-male-mouse year (1276) as birth-date, and Gyam in Zur rtso as its birthplace. He took novice vows when he was five years old at 'Brog rdo gling, and was ordained at seven.</note></person><person xml:id="person4213"><persName type="main" xml:lang="bo-Latn-x-wylie">dol po pa shes rab rgyal mtshan</persName><persName xml:lang="bo">དོལ་པོ་པ་ཤེས་རབ་རྒྱལ་མཚན</persName><birth notBefore="1292-01-01" notAfter="1292-12-31">1292</birth><death notBefore="1361-01-01" notAfter="1361-12-31">1361</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P139</idno><idno type="APIS">4213</idno></person></listPerson><listBibl><bibl xml:id="work3727"><title type="main" xml:lang="bo-Latn-x-wylie">bodhicaryāvatāra</title><title type="alt" xml:lang="bo-Latn-x-wylie">byang chub sems dpa'i spyod pa la 'jug pa</title><title type="alt" xml:lang="bo-Latn-x-wylie">spyod 'jug</title><date type="composition" notBefore="0610-01-01" notAfter="0800-12-31">after 610 before 800</date><author ref="person:3743">śāntideva</author><note type="isExtant">True</note><note type="comment">A fragmentary manuscript of the Tibetan translation (different from the canonical one) from Matho is discussed in [5H5BVSWI].</note><idno type="APIS">3727</idno></bibl><bibl xml:id="work3749"><title type="main" xml:lang="bo-Latn-x-wylie">ratnagotravibhāga</title><title type="alt" xml:lang="bo-Latn-x-wylie">rātnagotravibhāga mahāyānottaratantraśāstra</title><title type="alt" xml:lang="bo-Latn-x-wylie">uttaratantra</title><title type="alt" xml:lang="bo-Latn-x-wylie">theg pa chen po rgyud bla ma'i bstan bcos</title><author ref="person:3747">maitreya</author><author ref="person:3756">asaṅga</author><note type="isExtant">True</note><note type="comment">The authorship of the work comes to be ascribed to the future Buddha Maitreya (ID:3747) in the Indian tradition from the 11th c. onward and in the Tibetan tradition. On earlier witnesses ascribing the authorship to Sāramati or Sthiramati, see [BAQ9MH4T]: 20-27. No attribution of that work to Asaṅga (ID:3756) was located in Indian sources, but the colophon of the Tibetan translation by rNgog Blo ldan shes rab ascribes the verses to Maitreya and the prose commentary to Asaṅga ([BAQ9MH4T]: 27-28).&#13;
There are six Tibetan translations, only that by rNgog Blo ldan shes rab and Sajjana is currently extant ([BAQ9MH4T]: chap. 6).</note><idno type="APIS">3749</idno></bibl><bibl xml:id="work5153"><title type="main" xml:lang="bo-Latn-x-wylie">byang chub sems dpa'i spyod pa la 'jug pa'i 'grel pa gzhung don snang ba</title><title xml:lang="bo">བྱང་ཆུབ་སེམས་དཔའི་སྤྱོད་པ་ལ་འཇུག་པའི་འགྲེལ་པ་གཞུང་དོན་སྣང་བ</title><title type="alt" xml:lang="bo-Latn-x-wylie">spyod 'jug 'grel ba</title><title type="alt" xml:lang="bo-Latn-x-wylie">spyod 'jug 'grel pa gzhung don snang ba</title><textLang mainLang="bo"/><date type="composition" notBefore="1310-01-01">after 1310</date><author ref="person:4068">jo nang lo tsA ba blo gros dpal bzang</author><note type="isExtant">True</note><note type="comment">The work was requested by numerous students, some of whom are named in the colophon: Nam mkha' ye shes, Zhang Chos rgyal rin chen, Byams pa'i dpal.&#13;
