            <milestone unit="section" n="Colophon "/>
        <lb edRef="inst:5282" n="95a7"/> <rs type="work" ana="corpusmd:unnamed_reference" ref="work:5283"><choice><reg>rnaM</reg><orig>°M</orig></choice> bshad</rs> 'di ni <rs type="person" ana="corpusmd:unnamed_reference" ref="person:4593">tshig nyung dus gzhung gi don rgyas par <expan>rtogs</expan> par 'dod pa</rs> <expan>dag gis</expan> yang dang yang du bskul nas ¦ <choice><reg>sdom</reg><orig>d°oM</orig></choice> brtson daM pa mkhas pa'i <expan>mchog grub</expan> pa mnyes <expan>pa'i</expan> skyes bu <expan>chen po</expan> || snyan po dra gsung <expan>phyogs</expan> bcur <choice><orig><note type="gloss">'</note>phro</orig><reg>'phros</reg></choice> pa ¦ rnam par dag cing lhun gyis grub pa'i <expan>'phrin las</expan> kyis <choice><reg>bskal</reg><orig>°skal</orig></choice> pa dang ldan pa <choice><reg>rnams</reg><orig>rnaMms</orig></choice> kyi <expan>rnam par</expan> 'dren pa | <choice><orig>mtshangs</orig><reg>mtshungs</reg></choice> pa med pa ¦ <rs type="person" ana="corpusmd:named_reference" ref="person:4052">yang dag <expan>pa'i</expan> dge ba'i <expan>bshes gnyen</expan> <expan>smon lam</expan></rs> gyi mtshan <lb edRef="inst:5282" n="95a8"/> daM pa'i zhabs rdul spyi bos yang dag par len pa ¦ <rs type="person" ana="corpusmd:named_reference" ref="person:6029">shAkya'i dge slong <expan>sangs rgyas</expan> ston dpal bzang po</rs>s <choice><reg>sbyar</reg><orig>°byar</orig></choice> ba || <expan>rdzogs so</expan> || </seg>
        </ab>
        <ab type="colophon">
        <seg type="excerpt" xml:id="ex8602_202409183" status="finalized" ana="corpusmd:colophon"><milestone unit="section" n="Colophon (95a8-95a9)"/>
        <lg><l>sde snod mgnon pa mi'i sde bdun dang ¦</l>
        <l><expan>bye brag</expan> bshad mdzod nying khu lta bu yin |</l> 
        <l><rs type="work" ana="corpusmd:named_reference" ref="work:3761">mngon mdzod</rs> gzhung don bde blag <expan>rtogs</expan> bya'i phyir |</l> 
        <l>rnaM bshad nying khu pa'i 'od 'dra 'di |</l> <l>rang dang gzhan la phan phyir <rs type="person" ana="corpusmd:unnamed_reference" ref="person:6029"><expan>bdag</expan></rs> <expan>gis</expan> bzhengs |</l> 
        <l><expan>dge gshegs</expan> daM chos 'di dang mi 'bral zhing |</l> 
        <l>'gro ba °° <lb edRef="inst:5282" n="95a9"/> °° |</l> <l>mthug <expan>rnam mkhyen</expan> pa la 'god par shog |</l></lg>
        <rs type="person" ana="corpusmd:unnamed_reference" ref="person:4593">mkhan chen <expan>pa</expan></rs><expan>'i</expan> phyag dpe 'di |  <rs type="person" ana="corpusmd:named_reference" ref="person:5284">dbyang dpal</rs> gyi legs par bris pa 'di dge zhing <expan>bkra shis</expan> par 'gyur gcig || shub+haM || || ||</seg>
