         <ab>
           <lb edRef="inst:4703" n="29a1"/><seg type="shared" xml:id="ex034042026-11-1311-11-42" status="reviewed"> 
            <lg><l><rs type="work" ana="corpusmd:named_reference" ref="work:4704"><rs type="work" ana="corpusmd:named_reference" ref="work:3764">tshig ler byas pa</rs> rin chen 'phreng pa</rs> 'di' ||</l>
            <l>tshig don rgyas par gsal byed brtsams pa'i ||</l>
            <l>dge ba des ni 'gro ba ma lus pa ||</l>
            <l>rdzogs pa'i sangs rgyas <lb edRef="inst:4703" n="29a2"/> go 'phang myur thob shog ||</l></lg>||</seg>
           </ab>
