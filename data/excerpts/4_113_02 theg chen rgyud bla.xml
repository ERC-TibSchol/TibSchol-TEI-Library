      <note type="gloss"><rs type="person" ana="corpusmd:named_reference" ref="person:3977">mchims</rs> </note><rs type="person" ana="corpusmd:named_reference" ref="person:3977">nam mkha' grags</rs> || </l>
      <l><rs type="person" ana="corpusmd:named_reference" ref="person:4006">bcom ldan ral gri</rs> <rs type="person" ana="corpusmd:named_reference" ref="person:4062">kyi ston shag 'bum</rs> dang || </l>
      <l><rs type="person" ana="corpusmd:named_reference" ref="person:4221">kyi ston 'jam dbyangs</rs> <rs type="person" ana="corpusmd:named_reference" ref="person:4213">kun mkhyen chos rje</rs> dang || </l>
      <l><rs type="person">phyogs las rnam rgyal</rs> brgyud nas <rs type="person" ana="corpusmd:named_reference" ref="person:4125">lha</rs> la 'o ||</l></lg> dge'o || <note type="gloss">gnyi zhus</note></seg>
