       <rs type="person" ana="corpusmd:named_reference" ref="person:3758">dbyig gnyen</rs> 
       <rs type="person" ana="corpusmd:named_reference" ref="person:6262">blo bstan</rs> 
       <rs type="person" ana="corpusmd:named_reference" ref="person:6975">gang ba spel</rs> || </l>
      <l><rs type="person" ana="corpusmd:named_reference" ref="person:7726">rin chen rdo rje</rs>
      <rs type="person" ana="corpusmd:named_reference" ref="person:3800">sad dza na</rs> dang ni || </l>
      <l><rs type="person" ana="corpusmd:named_reference" ref="person:3798">pa ra hi ta</rs> 
      <rs type="person" ana="corpusmd:named_reference" ref="person:4092">blo gros grags pa</rs> dang || </l>
