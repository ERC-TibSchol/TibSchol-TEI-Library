      <lb edRef="inst:5475" n="60a4"/><seg type="excerpt" xml:id="ex113022025-02-2416-01-14" status="finalized" ana="corpusmd:colophon"> <milestone n="Colophon (60a3-60a7)" unit="section"/>
      <rs type="work" ana="corpusmd:named_reference" ref="work:5476"><rs type="work" ana="corpusmd:named_reference" ref="work:3749">theg pa chen po rgyud bla ma'i bstan bcos</rs> kyi rnam par bshad pa de nyid snang ba</rs> zhes <lb edRef="inst:5475" n="60a5"/> bya ba 'di mtshan nyid phyogs kyi lung rigs la rnam par byang zhing khyad par dpal dus kyi 'khor lo laswo pa rdo rje theg pa la blo gros kyi snang ba rgyas pa'i bshes gnyen chen po <rs type="person" ana="corpusmd:named_reference" ref="person:4593">slob dpon a mo g+ha</rs> × sa <rs type="work" ana="corpusmd:named_reference" ref="work:7338">rgyud bla'i Ti ka</rs> <rs type="work" ana="corpusmd:named_reference" ref="work:3749"><rs type="person" ana="corpusmd:named_reference" ref="person:3756">'phags pa thogs med</rs> kyi 'grel pa</rs> gzhir bzhag cing sa bcad <rs type="person" ana="corpusmd:named_reference" ref="person:4593">chos rje sa bzangs pa</rs>'i lugs bzhin du <lb edRef="inst:5475" n="60a6"/> phye ba rgyud bla'i thun mong ma yin pa'i chos skad lung rigs kyi zur thon par bya dgos rnaMs brten pa cig gyis shig ces pa'i gsung yig gis bskul ba la brten nas ¦ <rs type="person" ana="corpusmd:named_reference" ref="person:4593">chos rje jo nang pa yab sras</rs> kyis bka' drin las nges pa'i don la shes nas dad pa thob pa <rs type="person" ana="corpusmd:named_reference" ref="person:4125">shAkya'i dge slong lha'i rgyal mtshan</rs> gyis ston pa 'das nas <lb edRef="inst:5475" n="60a7"/> lo nyis stong nyis rgya dang nyer gsuM song ba'i dus lcags pho rta'i khrums stod kyi nyer lnga ‹'grub par› <rs type="place" ana="corpusmd:named_reference" ref="place:5732">dben gnas nam mkha' mdzod</rs> du sbyar ba bstan pa la phan pa rgya chen por gyur cig || </seg>

      <seg type="excerpt" xml:id="ex113022025-02-2416-01-142" status="finalized" ana="corpusmd:colophon"><milestone n="Colophon (60a3-60a7)" unit="section"/>
      <rs type="person" ana="corpusmd:named_reference" ref="person:4125">lha'i rgyal mtshan</rs> gyis sbyin par bya ba'i chos so ||</seg>

      <seg type="excerpt" xml:id="ex113022026-01-2622-34-04" status="finalized">
