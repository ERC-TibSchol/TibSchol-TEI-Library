		<ab>
            <gap reason="omitted"/><pb n="194"/><lb n="96b9"/><seg type="excerpt" xml:id="ex76012024-09-1612-18-36" status="finalized" ana="corpusmd:colophon"> de phyir bstan pa yun rings gnas phyir dang || rang nyid dran phyir gzhan la phan bya'i phyir || gzur gnas <pb n="97a"/>         
            <lb n="97a1"/>blo ldan don du gnyer ba yis || bshes gnyen rnams kyis legs par bskul ba'i mthus || <rs type="person" ana="corpusmd:named_reference" ref="person:4080">shAkya'i dge slong skyabs <choice><reg>mchog</reg><orig>m{chog}</orig></choice> dpal bzang po</rs>s || gzhung mchog 'di yi rnam bshar 'di byas so ||</seg><gap reason="omitted"/></ab>
				<ab type="colophon">
				<lb n="97a2"/><seg type="excerpt" xml:id="ex76012024-09-1612-39-18" status="finalized" ana="corpusmd:colophon"><milestone unit="section" n="Colophon (97a2-97a5)"/>
				<rs type="work" ana="corpusmd:named_reference" ref="work:5209"><rs type="work" ana="corpusmd:named_reference" ref="work:3715">dbu ma'i rtsa ba'i tshig le'ur byas pa shes rab</rs> ces bya ba'i rgya cher bshad pa ¦ tshig don rab tu gsal ba</rs> zhes <lb n="97a3"/> bya ba ¦ gsung rab kyi de kho na nyid thugs su chung nas ¦ 'chad brtsod brtsom pa la snang ba rab tu rgyas pa'i ¦ <rs type="person" ana="corpusmd:named_reference" ref="person:4593">sde snod 'dzin pa nyi ma seng ge</rs> dang ¦ <rs type="person" ana="corpusmd:named_reference" ref="person:4593">dpal gsang pa 'dus pa</rs> dang ¦ mtha' bral dbu ma chen po sogs ¦ <rs type="person" ana="corpusmd:named_reference" ref="person:3720">'phags pa klu sgrub</rs> yab sras kyi gzhung lugs la gzhan gyis brdzi bar mi nus pa'i spobs pa <note type="editorial">spobs is unclear.</note> dge ba can pa <lb n="97a4"/> <rs type="person" ana="corpusmd:named_reference" ref="person:4593">yong dbon po shAkya seng ge</rs> dang ¦ lung dang rigs pa'i de kho na nyid phyin ci ma log par smra zhing || chos tshul 'dis la mi phyed pa'i dad pa can | <rs type="person" ana="corpusmd:named_reference" ref="person:4091">mdo stod pa <expan>sangs rgyas</expan> 'bum</rs> <expan>la sogs</expan> pas bskul nas ¦ <rs type="person" ana="corpusmd:named_reference" ref="person:4080">shAkya'i dge slong skyabs mchog dpal bzang po</rs>s ¦ <rs type="person" ana="corpusmd:named_reference" ref="person:3725">dpal ldan zla ba grags pa</rs>'i 'grel ba bzhin du ¦ dbang <expan>phyug gi</expan> lo ¦ smin drug can gyi <lb n="97a5"/> zla ba'i dkar phyogs kyi tshes bcu gsum la sbyar ba'o || 
				<expan>yi ge</expan> pa ni <rs type="person" ana="corpusmd:named_reference" ref="person:6844">lung dang rigs par smra ba ¦ seng ge rgyal mtshan</rs> gyis <expan>bgyis so</expan> || 
				'di la <expan>brten nas</expan> <expan>sangs rgyas</expan> kyi bstan pa rin po che phyogs dang dus dang gnas skabs <expan>thams cad</expan> du dar zhing rgyas la yun ring du gnas par gyur cig |</seg></ab>
