         <pb n="5"/><seg type="shared" status="reviewed">
         <milestone unit="section" n="111b yul gsum po"/>
          <lb n="5.5"/> yul gsum po 'di la yang rang gi lugs rnam par bzhag pa dang | gzhan gyi lugs dgag pa gnyis so ||
         
         <milestone unit="section" n="111b.1 rang gi lugs rnam par bzhag pa"/>
         dang po ni <rs type="school">nyan thos bye brag tu smra ba</rs> dang mthun par don spyi dang rtog med 'khrul ba'i dmigs pa gnyis ni dngos por ma yin par thal | <rs type="school">dbu ma</rs>'i skabs su yang log pa'i kun rdzob bo ||
         don rang gi mtshan nyid ni dngos por yod de | <rs type="school">dbu ma</rs>'i skabs su'ang yang dag pa'i kun rdzob yin no ||</seg>
      <gap reason="omitted"/>
   </ab>
