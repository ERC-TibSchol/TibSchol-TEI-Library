         <ab xml:space="preserve">
         <pb n="59"/><seg type="excerpt" xml:id="exX0022024-11-01-14-51" status="finalized" ana="corpusmd:the_tshom"><milestone unit="section" n="(iv) the tshom"/>
         <lb n="59.20"/> the tshom la gsum las 
            <milestone n="mtshan nyid" unit="section"/>
            mtshan nyid ni blo rtse gnyis kyi rnam pas 'jug pa <lb n="59.21"/> zhes pa la <rs type="person" ana="corpusmd:named_reference" ref="db:3834">rgya</rs> bzhed do || <rs type="person" ana="corpusmd:named_reference" ref="db:3805">zhang tshes</rs> dang <rs type="person" ana="corpusmd:named_reference" ref="db:3831">phya pa</rs> ni mtha' gzhan du srid pa'i <pb n="60"/><lb n="60.1"/> dogs pa dang bcas pa'o zhes zer ro ||</seg>
      </ab>

