         <ab>
            <gap reason="omitted"/><lb edRef="inst:5154" n="3b8"/><lb edRef="inst:5150" n="4a3"/><seg type="shared" xml:id="ex066052026-07-0710-44-11" status="reviewed" ana="corpusmd:dgos_brel">
            2 pa shugs la bstan pa dgos <app><lem wit="inst:5154">'brel'</lem><rdg wit="inst:5154">'brel</rdg> <rdg wit="inst:5150">'br°ls</rdg></app> la 2 ¦ dgos don ¦ bsdus <lb edRef="inst:5154" n="3b9"/> don no || 
            <milestone n="dgos don" unit="section"/>
            dang po la 3 la ¦ 
            <milestone n="gzhan lugs dgag pa" unit="section"/>
            gzhan lugs dgag pa ni | 
            
            <milestone n="a. mu stegs byed" unit="section"/>
            <rs type="person" ana="corpusmd:unnamed_reference"><rs type="school">mu stegs byed</rs> kha 1</rs> la dgos 'brel ngag las bstan chos <lb edRef="inst:5150" n="4a4"/> la chos 4 yod par tshad mas nges pa skyes pa kho na yin zer ba 
            mi 'thad de the tshom dang <expan>yid dpyod</expan> kyi rtogs pa'ang dgos pa yin pa'i phyir ro ||
            
            <milestone n="b. blo brtan" unit="section"/>
            <rs type="person" ana="corpusmd:named_reference" ref="person:6262">blo brtan</rs> na re ¦
            snga rabs kyi gzhung bskyang pa yin zer ba 
            mi 'thad de ¦ <lb edRef="inst:5154" n="4a1"/> rtsom pa po thog ma'i dgos 'brel gyi ngag don med du 'gyur ba'i phyir ro || 
   
            <milestone n="c. zhi ba mtsho" unit="section"/>
            <app><lem wit="inst:5154"><rs type="person" ana="corpusmd:named_reference" ref="person:3732">zhi ba mtsho'</rs></lem> <rdg wit="inst:5154">zhi ba mtsho'</rdg> <rdg wit="inst:5150">zhi mtsho</rdg></app> na re bstan bcos dgos med du 'dzin pa'i log rtogs bzlog pa kho ba yin zer ba 
            mi <lb edRef="inst:5150" n="4a5"/> 'thad de | nying dgos ston pa'i ngag don med du 'gyur ba'i phyir ro || </seg>
            
            <seg type="excerpt" xml:id="ex066052026-07-0710-44-04" status="reviewed" ana="corpusmd:dgos_brel">
            <milestone n="d. lo tsha ba" unit="section"/>
            <rs type="person" ana="corpusmd:named_reference" ref="person:3786">lo tsha ba</rs> na re ¦ gzhung mdzes byed yin zer ba'ang 
            mi 'thad de ¦ <lb edRef="inst:5154" n="4a2"/> rjes su 'gro ldog ma grub cing <expan>gzhi'i</expan> <app><lem wit="inst:5150">grangs nges</lem><rdg wit="inst:5150">grangs nges</rdg> <rdg wit="inst:5154">grangs</rdg></app> mi grub pa'i phyir ro ||</seg>
            
             <seg type="shared" xml:id="ex066052026-07-0710-44-10" status="reviewed" ana="corpusmd:dgos_brel"><milestone n="rang lugs" unit="section"/>
            rang lugs la rnam gcad la dgos 'brel ngag las brjod bya swo 4 ma rtogs logs rtogs the
            tshom 3 sel zhing ¦ yongs gcod la chos 4 yod par rtogs pa yin te ¦ de yang dad pa'i rjes
               <lb edRef="inst:5150" n="4a6"/> 'brang la ma rtogs log rtogs sel zhing <expan>yid dpyod</expan> kyi nges pa skye'o ||
            <lb edRef="inst:5154" n="4a3"/> rigs pa'i rjes 'brang la ma rtogs pa dang the tshom sel zhing don 'gyur the tshom gyis rtogs te | <rs type="work" ana="corpusmd:named_reference">rnams bshad rig pa</rs>r ¦ 
            <quote><lg><l><expan>'jig rten</expan> don gnyer phal cher ni || </l>
            <l>the tshom las kyang 'jug phyir ro ||</l></lg></quote> ces bstan pa <expan>bzhin no</expan> || </seg><gap reason="omitted"/></ab>
         
