         <ab xml:space="preserve">
         <gap reason="omitted"/><ab xml:space="preserve">
         <seg type="shared" status="reviewed" xml:id="ex009042025-10-0811-57-39" part="M" next="ex009042025-10-0811-57-38"><milestone unit="section" n="212.1 dbye ba (2a4)"/>
         <lb n="2a4"/> dbye ba ni yul las dang | dpe' las dang | don las dang | zhu ba po las dang | shu lo ka la ste lnga'o ||</seg></ab>
         
         <ab xml:space="preserve">
         <seg type="shared" status="reviewed" xml:id="ex009042025-10-0811-57-38" part="M" next="ex9042024-09-1712-48-21"><milestone unit="section" n="212.2 'dogs lugs (2a4)"/>
         'dogs lugs ni skabs dang sbyar nas shes par bya ste | 'dir ni shu lo ka'i grangs las so ||</seg>
         </ab>
        <ab xml:space="preserve">
         <seg type="excerpt" xml:id="ex9042024-09-1712-48-21" status="finalized" part="F">
         <milestone unit="section" n="212.3 bsgyur ba (2a4–2a5)"/>
         bsgyur ba ni shan sbyar ba las <choice><orig>‹'›thob</orig><reg>'thob</reg></choice> ste | 
         <l><foreign xml:lang="sa-Latn-x-wylie">a rya</foreign> na 'phags pa'o ||</l> <foreign xml:lang="sa-Latn-x-wylie">sa rba</foreign> na <expan>thams cad</expan> do || 
         <l><foreign xml:lang="sa-Latn-x-wylie">a sti bA da</foreign> na yod par smra ba'o ||</l>
         <foreign xml:lang="sa-Latn-x-wylie">shra ma Ne ra</foreign> na dge tshul <lb n="2a5"/> lo || 
         <l><foreign xml:lang="sa-Latn-x-wylie">ka ri ka</foreign> na tshig le'ur byas pa'o ||</l><note type="editorial">The text being commented upon is identified here as having the Sanskrit title Ārya-sarva-astivāda-śrāmaṇera-kārikā, in Tibetan: 'Phags pa thams cad yod par smra ba'i dge tshul gyi tshig le'ur byas pa</note></seg>
         </ab>
      </ab>
         
