    <lb edRef="inst:4664" n="39b5"/><pb edRef="inst:6858" n="529"/><lb edRef="inst:6858" n="529.3"/><seg type="excerpt" xml:id="ex28022024-09-2015-39-312" status="finalized" ana="corpusmd:colophon" part="M" next="ex28022024-09-2015-39-31"><milestone unit="section" n="Closing verses (39b5-39b7)"/>
         <lg><l>thub pa'i gsung dang de'i dgongs <lb edRef="inst:4664" n="39b6"/> 'grel <lb edRef="inst:6858" n="529.4"/> rnams ||</l> 
            <l>spang <app><lem wit="inst:4664">spang</lem><rdg wit="inst:4664">spang</rdg><rdg wit="inst:6858">dpang</rdg></app> du byas <app><lem wit="inst:4664">ste</lem><rdg wit="inst:4664">ste</rdg><rdg wit="inst:6858">te</rdg></app> legs par bshad mod na'ang ¦</l> 
            <l><rs type="person" ana="corpusmd:unnamed_reference" ref="person:6857">bdag</rs> blo byis pa'i dbang gyur <lb edRef="inst:6858" n="529.5"/> 'gal 'khrul rnams ||</l> 
            <l><rs type="person" ana="corpusmd:unnamed_reference" ref="person:4593">daM pa rnaMs</rs> kyis bzod par mdzad du gsol ||</l> 
           <l> <rs type="person" ana="corpusmd:unnamed_reference" ref="person:6857">bdag</rs> gi phan <lb edRef="inst:6858" n="529.6"/> sems rgya mtsho las 'ongs pa'i ||</l> 
            <l>sgrung <app><lem wit="inst:6858">'grel</lem><rdg wit="inst:6858">'grel</rdg><rdg wit="inst:4664">'brel</rdg></app> ngo mtshar <expan>rin chen</expan> phreng ba 'di ||</l> 
            <l>skye rgu'i blo yi <lb edRef="inst:6858" n="529.7"/> dbul ba <app><lem wit="inst:4664">gtan</lem><rdg wit="inst:4664">gtan</rdg><rdg wit="inst:6858">brtan</rdg></app> bcoM nas ||</l> 
            <l><rs type="person" ana="corpusmd:unnamed_reference" ref="person:4593">kun mkhyen rgyal <lb edRef="inst:4664" n="39b7"/> ba</rs>'i dpal gyis 'byor gyur 1 |</l>
           <l> <rs type="person" ana="corpusmd:unnamed_reference" ref="person:6857">bdag</rs> kyang <lb edRef="inst:6858" n="529.8"/> <rs type="deity">'jam pa'i dbyangs</rs> kyis rjes bzung ste ||</l> 
            <l>thos bsaM sgom pa'i dpal 'byor gyis <lb edRef="inst:6858" n="529.9"/> phyug cing ||</l> 
