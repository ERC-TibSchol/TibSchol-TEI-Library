   <standOff><listPerson><person xml:id="person3765"><persName type="main" xml:lang="bo-Latn-x-wylie">śākyaprabha</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">mang du thos pa'i slob dpon shAkya 'od</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">shAkya 'od</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">shag kya 'od</persName><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P0AT0383</idno><idno type="APIS">3765</idno></person><person xml:id="person3941"><persName type="main" xml:lang="bo-Latn-x-wylie">rgya 'dul 'dzin dbang phyug tshul khrims</persName><persName xml:lang="bo">རྒྱ་འདུལ་འཛིན་དབང་ཕྱུག་ཚུལ་ཁྲིམས</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">rgya dbang phyug tshul khrims 'bar</persName><birth notBefore="1047-01-01" notAfter="1047-12-31">1047</birth><death notBefore="1131-01-01" notAfter="1131-12-31">1131</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P3063</idno><idno type="APIS">3941</idno><note type="comment">Native of Nyang stod Mang ra ba (or Mang rab) born in sTag gi rGya ma ra ba in the vicinity of rBa brCad, known as "rGya 'Dul 'dzin the elder" to distinguish him from "rGya 'Dul 'dzin the younger" (ID:4193). See [647FFPZR]: 541. See also [UGZJBIWM]: 376.&#13;
&#13;
Disciple of Zhang zhung pa rGyal ba'i shes rab and Ye shes&#13;
bla ma in sTod, gZhon tshul in 'Dzims and 'Brom Seng dkar in dBus. His disciples include sTon pa Yang rab from Glo bo, the elder and younger Brag ston in western gTsang, the elder Leng and the younger 'Brog, and 'Gar (=Rong pa 'Gar dGe ba gsal), 'Gos (=rje 'Gos) and Yol (=Yol Chos dbang) ([Q922IUFM]: 1: 98).</note></person><person xml:id="person3962"><persName type="main" xml:lang="bo-Latn-x-wylie">'dar tshul khrims rgyal po</persName><persName xml:lang="bo">འདར་ཚུལ་ཁྲིམས་རྒྱལ་པོ</persName><birth notAfter="1121-12-31">before 1121</birth><death notBefore="1057-01-01">after 1057</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P3JT13447</idno><idno type="APIS">3962</idno><note type="comment">Identical with 'Dar 'dul 'dzin (ID:4194)?</note></person><person xml:id="person3963"><persName type="main" xml:lang="bo-Latn-x-wylie">skye bo tshul 'phags</persName><persName xml:lang="bo">སྐྱེ་བོ་ཚུལ་འཕགས</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">skyi bo tshul 'phags</persName><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">3963</idno><note type="comment">Author of several works on monastic discipline. See [5RXEUKD9]: 536, No. 11713: rgya 'dul gyi slob ma skyi bo tshul 'phags kyi mdo rtsa'i Tik+ka po ti gsum.</note></person><person xml:id="person3964"><persName type="main" xml:lang="bo-Latn-x-wylie">sna nam mgo pa stod 'dul ba 'dzin pa tshul khrims 'bum</persName><persName xml:lang="bo">སྣ་ནམ་མགོ་པ་སྟོད་འདུལ་བ་འཛིན་པ་ཚུལ་ཁྲིམས་འབུམ</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">stod 'dul ba 'dzin pa tshul khrims 'bum</persName><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">3964</idno><note type="comment">Had many students, including Nyi steng pa Blo gros grags ([Z5WBK2VV]: 44).</note></person></listPerson><listBibl><bibl xml:id="work3764"><title type="main" xml:lang="bo-Latn-x-wylie">mūlasarvāstivādiśrāmaṇerakārikā</title><title type="alt" xml:lang="bo-Latn-x-wylie">āryamūlasarvāstivādiśrāmaṇerakārikā</title><title type="alt" xml:lang="bo-Latn-x-wylie">triśata­kārikā</title><title type="alt" xml:lang="bo-Latn-x-wylie">'phags pa gzhi thams cad yod par smra ba'i dge tshul gyi tshig le'ur byas pa</title><author ref="person:3765">śākyaprabha</author><note type="isExtant">True</note><idno type="APIS">3764</idno></bibl><bibl xml:id="work4698"><title type="main" xml:lang="bo-Latn-x-wylie">so sor thar pa'i rnam bshad</title><title xml:lang="bo">སོ་སོར་ཐར་པའི་རྣམ་བཤད</title><title type="alt" xml:lang="bo-Latn-x-wylie">so thar rnam bshad</title><textLang mainLang="bo"/><date type="composition" notBefore="1000-01-01" notAfter="1200-12-31">after 1000 before 1200</date><author ref="person:3962">'dar tshul khrims rgyal po</author><note type="isExtant">True</note><note type="comment">From the title, a commentary on Prātimokṣasūtra (ID:3690).</note><idno type="APIS">4698</idno></bibl><bibl xml:id="work4700"><title type="main" xml:lang="bo-Latn-x-wylie">sum brgya ba'i TIk+ka</title><title xml:lang="bo">སུམ་བརྒྱ་བའི་ཊཱིཀྐ</title><title type="alt" xml:lang="bo-Latn-x-wylie">tshig le'ur byas pa sum brgya ba'i 'grel pa</title><title type="alt" xml:lang="bo-Latn-x-wylie">sum rgya pa'i ti ka</title><title type="alt" xml:lang="bo-Latn-x-wylie">sum brgya pa'i ti ka</title><title type="alt" xml:lang="bo-Latn-x-wylie">tshig le'ur byas pa sum brgya pa'i tig 'grel</title><textLang mainLang="bo"/><date type="composition" notBefore="1100-01-01" notAfter="1200-12-31">after 1100 before 1200</date><author ref="person:3962">'dar tshul khrims rgyal po</author><note type="isExtant">True</note><relatedItem type="commentaryOn" target="work:3764"/><idno type="APIS">4700</idno></bibl></listBibl><listRelation><relation xml:id="rel704" name="author-of" active="#person3962" passive="#work4700" type="positive"><desc>Evidence: <ptr target="#ex034022026-11-1311-56-10"/></desc></relation><relation xml:id="rel4385" name="student-of" active="#person3962" passive="#per