            <ab>
               <gap reason="omitted"/><pb n="18.1b"/><lb n="18.1b4"/><seg type="excerpt" xml:id="ex64082024-12-1910-21-14" status="finalized">'di la <rs type="place" ana="corpusmd:named_reference" ref="db:5558"><expan>rgya gar</expan> <expan>'phags pa'i</expan> yul</rs> na | thal rang gnyis <expan>nyi ma</expan> zla ltar grags pa yin gyis | rang stong dang <expan>gzhan</expan> stong gsal bar ma grags | <rs type="place" ana="corpusmd:named_reference" ref="db:5559">bod</rs> 'dir yang <rs type="person" ana="corpusmd:named_reference" ref="db:3868">pa tshab nyi ma grags</rs> ma byon bar du | rang rgyud pa <expan>'ba zhig</expan> dar ba <expan>yin</expan> <lb n="18.1b5"/> <rs type="person" ana="corpusmd:named_reference" ref="db:3868">pa tshab</rs> <expan>byon nas</expan> | <rs type="place" ana="corpusmd:named_reference" ref="db:5559">bod</rs> 'dir yang | <expan>thal 'gyur</expan> gyi <expan>lasogs</expan> gsal bar byon | dus phyir | <expan>kun mkhyen</expan> <expan>chos sku</expan> 'dir man chad du | rang stong dang <expan>gzhan</expan> stong gi bsrol gnyis byung | </seg><gap reason="omitted"/></ab>
            
