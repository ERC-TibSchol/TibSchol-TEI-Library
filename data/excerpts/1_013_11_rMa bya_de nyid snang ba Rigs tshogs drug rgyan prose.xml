         <ab xml:space="preserve" type="cover_page">        
            <seg type="shared" status="reviewed" xml:id="ex13112025-10-0208-24-04" part="I" next="ex13112025-10-0208-24-44">
           <milestone n="Cover page (1a)" unit="section"/> <pb n="1a"/><lb n="1a1"/>phyi <lb n="2"/> tsa <lb n="1a3"/> 84 <lb n="1a4"/> <rs type="work" ana="corpusmd:named_reference" ref="db:4571"><rs type="work" ana="corpusmd:named_reference" ref="db:5632">dbu ma <expan>rigs tshogs</expan></rs> kyi rgyan de nyid snang ba</rs> bzhugs so ||</seg>
         </ab>

        <ab xml:space="preserve" type="incipit">
         <seg type="shared" status="reviewed" xml:id="ex13112025-10-0208-24-44" part="M">
         <milestone n="Incipit (1b)" unit="section"/>
        <milestone n="Title" unit="section"/> <pb n="1b"/><lb n="1b1"/>
        <rs type="work" ana="corpusmd:named_reference" ref="db:4571">dbu ma rigs pa'i tshogs kyi rgyan de kho na nyid snang ba</rs> zhes bya ba | 
        <milestone n="Invocation" unit="section"/>
        <rs type="deity">'phags pa 'jam dpal gzhon nur gyur pa</rs> la phyag 'tshal lo ||
      <milestone n="Introductory verses" unit="section"/>
        <lg><l>'dod chags lasogs dgra las rgyal gyur cing ||</l>
        <l>bde legs yon tan rin chen kun gyi gzhi ||</l>
        <l>srid zhir mi gnas zab cing rgya che'i lam ||</l>
        <l><rs type="deity">ston pa</rs> bla med de la phyag 'tshal lo ||</l></lg>
        
        <lg><l><rs type="deity">bde bar gshegs <lb n="1b2"/> pa</rs>'i gsung rab rgya mtsho'i ro ||</l>
        <l>gcig du rtogs nas lung dang rigs pa yis ||</l>
        <l>blo dman rnams la shin du gsal byed pa'i ||</l>
        <l>rgyal sras <rs type="person" ana="corpusmd:named_reference" ref="db:3720">klu sgrub </rs>zhabs la spyi bos 'dud ||</l></lg>

        <lg><l>chos rnams kun la blo yis spyan mnga' zhing ||</l>
       <l> nyes pa'i skyon bral tshul khrims dri bsrung pa ||</l>
        <l>rtse cig yid kyis bdag gzhan don sgrub pa'i ||</l>
        <l>rgyal mtshungs <rs type="person" ana="corpusmd:unnamed_reference" ref="db:4593">bla ma rnams</rs> la phyag 'tshal lo ||</l></lg>

        <lg><l><lb n="1b3"/> de ltar don 'di shin du gsal mod kyang ||</l>
        <l>skye bo phal cher chags sdang rmongs pa yis ||</l>
        <l>legs bshad nyes bshad rnam par mi phyed pas ||</l> 
        <l>dbu ma'i de nyid ji bzhin bstan phyir brtsam ||</l></lg></seg>
        </ab>
        
