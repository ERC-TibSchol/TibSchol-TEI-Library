         <ab type="colophon">
         <pb n="34a"/><lb n="34a7"/><seg type="excerpt" xml:id="ex1310-13112023-09-15-112027" status="finalized" ana="corpusmd:colophon">
         <milestone unit="section" n="Colophon (34a7-34a9)"/>
            <rs type="person">bde bar gshegs pa</rs>'i bka' rab 'byam gyi don gsal bar byed pa <rs type="person" ref="db:3720" ana="corpusmd:named_reference">slob dpon bdag nyid chen po 'phags pa klu grub</rs> kyi <rs type="work" ref="db:4569" ana="corpusmd:named_reference"><rs type="work" ana="corpusmd:named_reference" ref="db:5632">dbu ma rigs pa'i tshogs</rs> kyi rgyan de kho na nyid snang ba</rs> zhes bya ba <lb n="34a8"/> snyigs ma'i dus na bde bar gshegs pa<app><lem wit="">'i bstan pa</lem><rdg wit="inst:4570">°°°°</rdg></app>
            lnga brgya bdun pa la <rs type="place" ana="corpusmd:named_reference" ref="db:5559">gangs ri'i khrod la kha ba can gyi ljongs</rs> su 'khrungs pa | brtul zhugs kyi khur 'dzin cing bka' dang bstan bcos kyi gzhung rab 'byam la rtogs pa'i snang ba thob pa'i mkhas pa'i skye bo dam pa du ma bsten pa yis bstan pa'i khur 'dzin cing zab mo'i don la rigs pa'i dbang phyug du gyur pa lta ba ngan pa'i rgol ba <lb n="34a9"/> ma lus par 'joms par mdzad pa | <rs type="person" ref="db:3842" ana="corpusmd:named_reference">shag kya'i dge slong byang chub brtson 'grus </rs> kyis sbyar ba || rdzogs s+ho || || dge'o || bde legs su gyur cig |||</seg></ab>

