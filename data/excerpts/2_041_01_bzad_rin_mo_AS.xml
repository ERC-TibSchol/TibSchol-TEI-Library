            <gap reason="omitted"/><pb n="3b"/><lb n="3b8"/><seg type="excerpt" xml:id="ex41012024-09-1014-28-24" status="finalized">yang <rs type="person" ana="corpusmd:named_reference" ref="person:3786">lo tsha ba</rs> na re rtso pa'i skabs mngon du byas nas gzhung mdzes par 'gyur ba tsaM ngag 'di'i <expan>'bras bu</expan> yin la | de yang rang <expan>bzhin</expan> kyi mdzes pa ngag 'di'i <expan>'bras bur</expan> mi 'dod kyi bcos mas ba shes pa ngag gis <expan>'bras bur</expan> 'dod pas gzhung 'buM pa <expan>la sogs</expan> pa rang <expan>bzhin</expan> gyi mdzes pa yod kyang dgos 'brel gyi ngag <expan>med</expan> pas bcos mas mdzes pa <expan>med</expan> do zhes zer pa yang ma yin te | </seg><gap reason="omitted"/>
                     </p>
         
         <gap reason="omitted"/>
         
         
         
         <p>
            <gap reason="omitted"/><pb n="5b"/><lb n="5b3"/><seg type="excerpt" xml:id="ex41012025-05-0612-52-43" status="finalized"><milestone n="1. gzhan lugs dgag pa" unit="section"/>
		dang po ni <rs type="person" ana="corpusmd:named_reference" ref="person:3786">lo tsha ba</rs> na re brjod bya bden pa yod par bstan pas bden rtogs kyi dgos pa <expan>med</expan> pa'i log rtogs khyegs la | <expan>de dgos</expan> pa bstan pas sgrub mi nus pa'i
				<lb n="5b4"/> log rtogs khyegs so zhes zer ba ni ma yin te | brjod bya bden pa yod par bstan pas de nyid <expan>med</expan> pa'i log rtogs khegs kyang de rtogs dgos pa <expan>med</expan> pa'i log rtogs mi khegs te | brjod bya bden pa yod pa la de rtogs pas ma khyab pa'i phyir shing yod par bstan pas sha pa <expan>med</expan> pa'i log rtogs mi khegs pa'i <expan>bzhin no</expan> ||
				 yang dgos pa bstan pas de nyid <expan>med</expan> pa'i log rtogs khegs kyang sgrub mi nus pa'i <lb n="5b5"/> log rtogs mi khyegs te | dgos pa yod pa la sgrub nus pas ma khyab pa'i phyir 'jog po'i nor bu <expan> bzhin no</expan> || </seg>
				<gap reason="omitted"/></p>
         
