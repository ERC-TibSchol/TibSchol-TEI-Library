   <standOff><listPerson><person xml:id="person4066"><persName type="main" xml:lang="bo-Latn-x-wylie">rgyal sras thogs med bzang po</persName><persName xml:lang="bo">རྒྱལ་སྲས་ཐོགས་མེད་བཟང་པོ</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">ma Ni pa thogs med</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">dngul chu rgyal sras thogs med bzang po</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">btsun pa thogs med</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">rgyal sras dngul chu thogs med</persName><birth notBefore="1295-01-01" notAfter="1295-12-31">1295</birth><death notBefore="1369-01-01" notAfter="1369-12-31">1369</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P1830</idno><idno type="APIS">4066</idno></person><person xml:id="person5066"><persName type="main" xml:lang="bo-Latn-x-wylie">dpal ldan ye shes</persName><persName xml:lang="bo">དཔལ་ལྡན་ཡེ་ཤེས</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">slob dpon dpal ldan ye shes</persName><birth notBefore="1315-01-01" notAfter="1359-12-31">after 1315 before 1359</birth><death notBefore="1320-01-01" notAfter="1440-12-31">after 1320 before 1440</death><sex value="M"/><nationality>Tibetan</nationality><idno type="APIS">5066</idno><note type="comment">Likely to be identical to (ID:4112).</note></person></listPerson><listBibl><bibl xml:id="work5053"><title type="main" xml:lang="bo-Latn-x-wylie">blo sbyong zin bris dang dmar khrid zin bris bcas</title><title xml:lang="bo">བློ་སྦྱོང་ཟིན་བྲིས་དང་དམར་ཁྲིད་ཟིན་བྲིས་བཅས</title><textLang mainLang="bo"/><date type="composition" notBefore="1325-01-01" notAfter="1440-12-31">after 1325 before 1440</date><author ref="person:5066">dpal ldan ye shes</author><note type="isExtant">True</note><idno type="APIS">5053</idno></bibl><bibl xml:id="work5068"><title type="main" xml:lang="bo-Latn-x-wylie">jo bo rin po che'i bstod pa la sogs pa yi dam gyi lha 'ga' zhig gi bstod pa</title><title xml:lang="bo">ཇོ་བོ་རིན་པོ་ཆེའི་བསྟོད་པ་ལ་སོགས་པ་ཡི་དམ་གྱི་ལྷ་འགའ་ཞིག་གི་བསྟོད་པ</title><textLang mainLang="bo"/><date type="composition" notBefore="1305-01-01" notAfter="1369-12-31">after 1305 before 1369</date><author ref="person:4066">rgyal sras thogs med bzang po</author><note type="isExtant">True</note><note type="comment">Instance (ID:5068) contains several eulogies/prayers, (i) f. 1b-2a7 "'jam pa'i dbyangs la bston pa", requested by yang dag pa'i dge ba'i bshes gnyen dpal ldan ye shes, composed by btsun pa thogs med. (ii) 2a7-3b3 "'phags pa spyan ras gzigs dbang phyug la bston pa'i tshigs su bcad pa phan bde'i 'byung gnas", composed by ma Ni pa thogs med in dNgul chu'i chos rdzong. (iii) 3b3-5a4 "spyan ras gzigs la bstod pa tshig rgyan me tog phreng ba", composed by chos smra ba'i btun pa thog pa med; (iv) 5a4-6a3 ?; (v) 6a3-7a1 "bsnyen rdzogs kyi mkhan rgyud la bston pa", requested by slob dpon byams chos pa byang chub rgyal mtshan, composed by chos smra ba'i btun pa thogs med in dNgul chu'i chos rdzong, scribe was 'byam (sic) dbyangs dkar po ; (vi) 7a1-7b8, composed by thogs med for the "jo bo bskor ba rnams".</note><idno type="APIS">5068</idno></bibl></listBibl><listPlace><place xml:id="place5692"><placeName xml:lang="bo-Latn-x-wylie">dngul chu'i chos rdzong</placeName><placeName xml:lang="bo">དངུལ་ཆུའི་ཆོས་རྫོང</placeName><placeName type="alt" xml:lang="bo">chos rdzong</placeName><placeName type="alt" xml:lang="bo">dngul chu chos rdzong</placeName><placeName type="alt" xml:lang="bo">dngul chu ri khrod</placeName><location><geo>29.399722 88.233056</geo></location><idno type="APIS">5692</idno></place><place xml:id="place5950"><placeName xml:lang="bo-Latn-x-wylie">rA tI dga' ldan byams pa gling</placeName><placeName xml:lang="bo">རཱ་ཏཱི་དགའ་ལྡན་བྱམས་པ་གླིང</placeName><placeName type="alt" xml:lang="bo">bsti gnas dam pa ra ti dga' ldan gyi chos grwa chen po</placeName><placeName type="alt" xml:lang="bo">rA tI dgon</placeName><placeName type="alt" xml:lang="bo">ra this dgon</placeName><placeName type="alt" xml:lang="bo">rA tI byams pa gling</placeName><location><geo>29.966667 101.583333</geo></location><idno type="APIS">5950</idno></place></listPlace><listRelation><relation xml:id="rel4714" name="requests" active="#person5066" passive="#person4066" type="positive"/><relation xml:id="rel1903" name="active-at" active="#person5066" passive="#place5692" type="positive"/><relation xml:id="rel5615" name="author-of" active="#person5066" passive="#work5053" type="positive"/><relation xml:id="rel2874" name="prompter-of" active="#person5066" passive="#work5068" type="positive"/><relation xml:id="rel2149" name="composed-at" active="#work5053" passive="#place5950" type="positive"/></listRelation></standOff><text>
