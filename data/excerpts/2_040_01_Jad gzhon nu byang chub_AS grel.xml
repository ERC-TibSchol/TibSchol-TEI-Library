      <body>
         
       <ab xml:space="preserve" type="cover_page">
        <seg type="excerpt" xml:id="ex40012024-12-2012-56-15" status="finalized">
         <milestone unit="section" n="Cover page (1a)"/>
        <pb n="1a"/> <rs type="work" ana="corpusmd:named_reference" ref="db:4750"><rs type="work" ana="corpusmd:named_reference" ref="db:3755">mngon pa kun las btus pa</rs>'i ti ka</rs> ¦ <rs type="person" ana="corpusmd:named_reference" ref="db:3863">mkhas pa chen po gzhon byang</rs> gis mdzad pa ¦ <rs type="work" ana="corpusmd:named_reference" ref="db:4750">shes bya <expan>thams cad</expan> gsal bar byed pa'i sgron me</rs> bzhugs s+ho ||</seg>
      </ab>
        <gap reason="omitted"/>
         
         
         
         
         
         
         
         <ab xml:space="preserve"><gap reason="omitted"/><lb edRef="inst:4749" n="1b5"/><seg type="excerpt" xml:id="ex040012026-07-0808-34-28" status="reviewed">'di la <rs type="person" ana="corpusmd:named_reference" ref="db:4261">mchims</rs> na re mdo'i sde ba yang brjod byed kyi ngo bo sgra spyir snang ba'i shes pa la 'dod de |
            <quote>
         <lg>
            <l xml:space="preserve">sgra rnams kyis ni brdar <lb edRef="inst:4749" n="1b6"/> lag pa ston ||</l><l>sgra ni tha snyad ched du byas ||</l><l>ngag gi mtshan nyid brjod bya yin ||</l><l>de nas de la brdar ma yin ||</l>
         </lg>
      </quote> zhes zer ro ||</seg>

         <seg type="excerpt" xml:id="ex040012026-07-0808-34-29" status="reviewed">de la <rs type="person" ana="corpusmd:named_reference" ref="db:3921">tho</rs> na re mdo' sde ba 'dod lugs mi 'dra ba dra ba °°o°° 'di ste | sgra rang gyi mtshan nyid la rjod byed du chos mngon pa brjod nas bshad do zhes zer ro ||</seg>
   
         <seg type="excerpt" xml:id="ex040012026-09-1401-05-22" status="reviewed"><rs type="school">rnal 'byor spyod pa sems tsam pa</rs>s ni | rjod byed kyi ngo bo rnaM par rig pa'i tshogs la 'dod do | <lb edRef="inst:4749" n="1b7"/> de dag ni 'og nas rgyas par shes par bya'o || 
            
         'di la <rs type="person" ana="corpusmd:named_reference" ref="db:4242">rog</rs> rjes 'brang dang bcas pa na re brjod bya don ni rtan la dbab rgyu sam shes par bya rgyu yin la | rjod byed tshig ni de rtan la 'bebs par byed pa yin zhes kyang zer ro || </seg><gap reason="omitted"/></ab>
         <gap reason="omitted"/>
         
         
         
         
         
         <p>
            <gap reason="omitted"/> <pb edRef="inst:4749" n="2b"/><lb edRef="inst:4749" n="2b4"/><seg type="shared" xml:id="ex04012026-07-0808-43-53" status="reviewed">'o na theg pa chen po gsang sngags sde snod 3 gyi gang du 'du zhe na | 
            <lb edRef="inst:4749" n="2b5"/> <rs type="person" ana="corpusmd:unnamed_reference" ref="db:4593">bod bgres po rnaMs</rs> na re mdo' sde'i sde snod du 'dus ste | gsang sngags mdo' sde'i tshul du ngas bshad nyon zhes pa lasogs pa'o zhes <expan>zer ro</expan> || </seg>

            <pb edRef="inst:4749" n="2b"/><seg type="excerpt" xml:id="ex04012026-07-0808-43-55" status="reviewed"><rs type="person" ana="corpusmd:named_reference" ref="db:4261">mchims</rs> na re gsang sngags ni sde snod 3 kar <expan>'dus so</expan> || gsang sngags mdo' sder 'dus par bshad pa ni <quote>mdo' sde'i sde snod du 'dus pa'i gsang sngags rnaMs | gsang sngags mdo' sde'i tshul du ngas bshad nyon ¦</quote> zhes gsungs pa yin gyi gsang sngags <expan>thams cad</expan> mdo' sde'i sde snod du 'dus pa yin no || <lb edRef="inst:4749" n="2b6"/> zhes <expan>zer ro</expan> || </seg>
            
            <pb edRef="inst:4749" n="2b"/><seg type="excerpt" xml:id="ex04012026-07-0808-43-56" status="reviewed">spyir mdo'i sde dang rgyud sde zhes bya ba yang de kho na nyid gzhan dang gzhan gyis grol bar 'dod pa'i gnyen por mdo' sde bshad la | snyoMs par 'jug pa gzhan dang gzhan gyis grol bar 'dod pa'i gnyen por rgyud sde bshad do zhes <rs type="person" ana="corpusmd:named_reference" ref="db:3810">gangs ba</rs> dang <rs type="person" ana="corpusmd:named_reference" ref="db:4261">mchims</rs> <expan>zer ro</expan> || </seg><gap reason="omitted"/><pb edRef="inst:4749" n="2b"/><lb edRef="inst:4749" n="2b7"/><seg type="excerpt" xml:id="ex40012024-10-25-12-39" status="finalized"> 
            <rs type="person" ana="corpusmd:named_reference" ref="db:4243">
            b+han</rs> na re rang sangs rgyas ni sangs rgyas myi bzhugs pa'i zhing khaMs su skye ba'i phyir bcoM
            ldan 'das kyi 'khor du chos nyan du mi 'ong bas de'i don du bstan ba'i chos <expan>med</expan> pa'i yin
            pas nyan thos gyi sde snod las gud pa <expan>med</expan> pa <expan>yin no</expan> zhes <expan>zer ro</expan> || </seg>
            <gap reason="omitted"/>
         </p>
         
         <p>
            <gap reason="omitted"/><lb n="2a2"/><pb n="6"/><seg type="excerpt" xml:id="ex04012026-07-0808-43-57" status="reviewed">yang <rs type="person" ana="corpusmd:named_reference" ref="db:4261">'chiMs</rs> na re blang bya'i dbang du byas pa dang <note type="gloss">|</note> dor bya'i dbang du byas pa'o || dor byas pa yang dor bya dngos sdug <expan>bsngal lo</expan> || de'i rgyu kun <expan>'byung ngo</expan> || blang bya la yang blang bya dngos 'gog pa'o | <lb n="3b3"/> de'i rgyu laM  yin pas bden pa bzhir grangs nges so zhes <note type="gloss">ga</note><expan>zer ro</expan> ||</seg><gap reason="omitted"/></p>
         
         <gap reason="omitted"/>
         
         
         
         
         
         
         
         <p>
            <gap reason="omitted"/>
            
            <pb edRef="inst:4749" n="3a"/><lb edRef="inst:4749" n="6a7"/><seg type="excerpt" xml:id="ex40012024-10-25-14-01" status="finalized"> 
            <rs type="person" ana="corpusmd:named_reference" ref="db:3786">lo tsa ba</rs> na de gang zhig dpyad na rigs pas mi 'thad pa ni kun rdzob kyi bden pa yin la
            dpyad na rigs pas 'thad pa ni don daM pa'i bden pa <expan>yin no</expan> || </seg>
            
            <gap reason="omitted"/></p>
         
         <p>
            <gap reason="omitted"/>
            <pb edRef="inst:4749" n="3a"/><lb edRef="inst:4749" n="6b5"/><seg type="excerpt" xml:id="ex40012024-10-25-13-07" status="finalized"> 
            <milestone n="1. snang ba mi sel ba'i lugs" unit="section"/>   
            mi sel ba ni rigs pa'i shes pa la chos can gzugs <expan>la sogs</expan> pa snang bar 'dod pa ste | gal te rigs shes la chos can mi snang na rigs shes kyis chos can snang ba 'di la sgro 'dogs mi chod par 'gyur te | <expan>myig gi</expan> rnaM shes la sgra myi snang bas sgra la sgro 'dogs mi chod pa <expan>bzhin no</expan> ||
            zhes <rs type="person" ana="corpusmd:named_reference" ref="db:3809">jo btsun</rs> rjes 'brang 'dod do ||</seg>
            
            <pb edRef="inst:4749" n="3a"/><lb edRef="inst:4749" n="6b5"/><seg type="excerpt" xml:id="ex040012026-02-2412-35-22" status="finalized">
            <milestone n="2. snang ba sel ba'i lugs" unit="section"/>
             sel ba la yang 2 las 
             <milestone n="a." unit="section"/>
             chos can snang <lb edRef="inst:4749" n="6b6"/> ba 'di rigs shes kyi dgag bya yin pas mi snang bar 'dod pa ni <rs type="person" ana="corpusmd:named_reference" ref="db:6795">rgya yon tan seng ge</rs> laso pa'o ||
             <milestone n="b." unit="section"/>
            rigs shes kyi dgag bya ma yin yang rigs shes kyi yul ma yin pas mi snang ste || dper na <expan>dmig gi</expan> rnaM shes kyi dgag bya sgra ma yin yang <expan>mig gi</expan> rnaM shes kyi yul ma yin pas mi snang ba bzhin zhes 'dod pa ni <rs type="person" ana="corpusmd:named_reference" ref="db:3810">gangs pa</rs> las pa'o || 
            de lta ma yin par rigs shes la chos can snang na chos can snang ba rigs grub du <lb edRef="inst:4749" n="6b7"/> 'gyur te rigs pa'i yul du bden  pa'i phyir zhes <expan>zer ro</expan> || || </seg><gap reason="omitted"/></p>
         
         <p>
            <gap reason="omitted"/><lb n="5b3"/><pb n="7a"/><seg type="excerpt" xml:id="ex04012026-07-0808-43-59" status="reviewed">yang <rs type="person" ana="corpusmd:named_reference" ref="db:4261">mchiMs</rs> na re yul 1 du ngag rgyun chags 'du gsungs kyi thor bu pa ma  <lb n="7a2"/> yin par gsungs pa ni bka' yin la || de las bzlog pa ni bstan chos so zhes <expan>zer ro</expan> || </seg>

           <gap reason="omitted"/></p>
         
         <gap reason="omitted"/>
         
         <p>
            <gap reason="omitted"/>
      
            <pb edRef="inst:4749" n="6b"/><lb edRef="inst:4749" n="8b2"/><seg type="excerpt" xml:id="ex040012026-09-0103-28-28" status="reviewed">'di la <rs type="person" ana="corpusmd:named_reference" ref="db:4261">mchims</rs> na re sangs rgyas kyi mdzad pa zhes bya ba las bcu' 2 zhes
            bya ba'i grangs mdo'aM bstan chos gang na'ang ma mthong ngo zhes zer kyang | <rs type="work">rgyud bla ma</rs> nas bcu' 2su mngon te | <quote>thugs rje chen pos 'jig rten mkhyen || 'jig rten kun la gzigs nas ni
            || chos kyi sku las ma g.yos par || skye ba mngon par skye ba dang || dga' ltar gnas °°° dang || <lb edRef="inst:4749" n="8b3"/> lhuMs su 'jug dang bltas pa dang || gzhon nu rol ched mdzad pa
            dang | btsun mo'i 'khor gyis rol pa dang || nges 'byung dga' ba spyod pa dang | byang
            chub snying por gshegs pa dang || bdud sde 'joMs dang rdzogs par ni || byang chub chos gyi 'khor lo dang || mya ngan 'das par gshegs mdzad rnaMs || srid pa ji srid gnas par ston ||</quote>
            zhes <expan>bcad do</expan> || </seg><gap reason="omitted"/></p>
         
         <gap reason="omitted"/>
         
         
         
         <p>
            <gap reason="omitted"/><pb edRef="inst:4749" n="6b"/><lb edRef="inst:4749" n="10a4"/><seg type="excerpt" xml:id="ex40012024-10-25-12-31" status="finalized"> 
            <rs type="person" ana="corpusmd:named_reference" ref="db:3807">'bre</rs> na re 3
            lhag pa'i yo byad du byin gyis <expan>brlabs so</expan> zhes <expan>zer ro</expan> ||</seg><gap reason="omitted"/></p>
         
         <gap reason="omitted"/>
         
         <p>
            <gap reason="omitted"/><pb edRef="inst:4749" n="6b"/><lb edRef="inst:4749" n="11a6"/><seg type="excerpt" xml:id="ex40022024-10-25-13-29" status="finalized">
            <rs type="person" ana="corpusmd:named_reference" ref="db:4189">lha rje dags po</rs> na re ri de la gnas pa'i dge' slong rnaMs su 'phrul gyis naM mkha' la 'gro ba <expan>la sogs</expan> pa byed
            pas bya rgod dang chos mthun pa'i phyir bya rgod phung po'i ri <expan>yin no</expan> zhes <expan>zer ro</expan> ||</seg>
            
            <pb edRef="inst:4749" n="6b"/><lb edRef="inst:4749" n="11a6"/><seg type="excerpt" xml:id="ex40022024-10-25-13-10" status="finalized">
            <rs type="person" ana="corpusmd:named_reference" ref="db:4294">khyung po <expan>grags se</expan></rs> na re dge' slong rnaMs kyi chos gos sur smrig dmar por yod pa la bya rgod rnaMs kyi
            bsaM pa la sha yin snyaM nas 'phungs pas na bya rgod phung po'i ri bo zhes zer ste spar tshod du <expan>zad do</expan> |</seg><gap reason="omitted"/>
       
            </p>
         
         <gap reason="omitted"/>
         
         
         
         
         
         
         
         
         
         
         
         
         
         
         
         
         
         
         
         
         
         <p>
            <gap reason="omitted"/><lb n="17b8"/><pb n="36"/><seg type="excerpt" xml:id="ex040012026-09-2203-10-42" status="reviewed">yang lugs 2 pa <lb n="18b4"/> ni <rs type="person" ana="corpusmd:named_reference" ref="db:3809">jo btsun</rs> dang <rs type="person" ana="corpusmd:named_reference" ref="db:4243">b+han</rs> na re lugs dang po ni mi legs ste | gzhung mdzes byed du 'dod pas kyang mthar 'jug pa'i yan lag du khas blangs pa dang | mdzes byed du 'dod pa la yang nyes pa drug mtshungs <expan>pas so</expan> || </seg><gap reason="omitted"/></p>
         
         <gap reason="omitted"/>
         
         
         
         
         
         
         
         
            
         <p>
            <gap reason="omitted"/>
            
            <pb edRef="inst:4749" n="6b"/><lb edRef="inst:4749" n="21a6"/><seg type="excerpt" xml:id="ex400122024-10-25-12-52" status="finalized">  
            'di ni seMs tsaM rnaM brdzun dang bye brag du smra ba ltar brjod bya dngos <expan>med</expan> yin kyang
            rnaM bden ltar na gzung cha don spyi dang | dgos pa don spyir snang ba de shes rig gi
            rdzas dngos po 1 du 'dod pas snga ma ltar khas blang dgos so zhes <rs type="person" ana="corpusmd:named_reference" ref="db:3864">byang chub skyabs</rs> <expan>gsung ngo</expan> |</seg>

             <pb edRef="inst:4749" n="6b"/><lb edRef="inst:4749" n="21a6"/><seg type="excerpt" xml:id="ex400122024-10-25-12-56" status="finalized">dgos 'brel na ji ltar bstan pa ni phang <lb edRef="inst:4749" n="21a7"/> bar dgos 'brel bkod pa <expan>med do</expan> || 
            <rs type="person" ana="corpusmd:named_reference" ref="db:4264">gnyags</rs> na re brjod bya dngos su bstan la 2 shugs kyis bstan pa yin zhes <expan>zer ro</expan> ||</seg><gap reason="omitted"/>
            <pb edRef="inst:4749" n="6b"/><lb edRef="inst:4749" n="21b5"/><seg type="excerpt" xml:id="ex040012026-09-2203-13-27" status="reviewed">yang na ni <rs type="person" ana="corpusmd:named_reference" ref="db:3809">jo btsun</rs> na re dgos pa <expan>med daM</expan> snyaM pa'i gnyen pos dgos pa bstan la | bsgrub par mi nus saM snyaM pa'i gnyen cing<note type="editorial">Unclear syllable</note> brjod bya bstan to || rtog pa tha ma 2 gyi gnyen po ni snga ma <expan>bzhin no</expan> || zhes <expan>zer ro</expan> || </seg><gap reason="omitted"/></p>
         
         <gap reason="omitted"/>
         
         
         
         
         
         
         
         
         
         <p>
            <gap reason="omitted"/><pb edRef="inst:4749" n="6b"/><seg type="excerpt" xml:id="ex040012026-09-1602-58-09" status="reviewed">
            <lb edRef="inst:4749" n="24b9"/><rs type="person" ana="corpusmd:named_reference" ref="db:4264">gnyags</rs> na re gzugs rags pa la yang <rs type="school">bye brag du smra ba</rs> khas len te | dbyibs rdzas su 'dod pas so zhes zer ro ||</seg><gap reason="omitted"/>
      
            
        
             <pb edRef="inst:4749" n="6b"/><lb edRef="inst:4749" n="25b1"/><seg type="excerpt" xml:id="ex040012026-09-1601-48-35" status="reviewed">de'ang 
               <milestone n="a. gangs pa" unit="section"/>
               <rs type="person" ana="corpusmd:named_reference" ref="db:3810">gangs pa</rs> na re gzung cha dang 'dzin cha 2 ga la rnaM pa zhes bya'o zhes <expan>zer ro</expan> ||
                <milestone n="b. jo btsun, b+han" unit="section"/>
            <rs type="person" ana="corpusmd:named_reference" ref="db:3809">jo btsun</rs> dang <rs type="person" ana="corpusmd:named_reference" ref="db:4243">b+han</rs> na re shes pa'i gzung cha la <lb edRef="inst:4749" n="25b2"/> rnaM pa zhes bya 'o zhes <expan>zer ro</expan> || </seg><gap reason="omitted"/><pb edRef="inst:4749" n="6b"/><pb n="25b"/><lb n="25b6"/><lb edRef="inst:4749" n="25b9"/><seg type="excerpt" xml:id="ex40012024-10-25-14-10" status="finalized">
            de nyid la 
            <milestone n="a. gnyags" unit="section"/>
            <rs type="person" ana="corpusmd:named_reference" ref="db:4264">gnyags</rs> na re byed pa'i tshig brgyad ces <expan>zer ro</expan> ||
               <milestone n="b. rog" unit="section"/>
            <rs type="person" ana="corpusmd:named_reference" ref="db:4242">rog</rs> na re sgra'i gnas brgyad ces zer ba ni mi legs ste |
           
         <pb n="26a"/>
         
            <lb edRef="inst:4749" n="26a1"/> sgra'i gnas rkan dang lce <expan>la sogs</expan> pa yin <expan>pas so</expan> || </seg><gap reason="omitted"/><pb edRef="inst:4749" n="6b"/><lb edRef="inst:4749" n="26a6"/><seg type="excerpt" xml:id="ex40012024-10-25-14-11" status="finalized">
           <milestone n="gnyags" unit="section"/>
            <rs type="person" ana="corpusmd:named_reference" ref="db:4264">gnyags</rs> na re phung po lnga zhes pa de gzugs kyi chos su bskol na gzugs
            kyang yin la phung po 'ang yin pas gzugs kyi phung po zhes pa gzhi' mthun gyi drug pa yin
