      <body>
                    <ab xml:space="preserve" type="incipit">
               <seg type="excerpt" xml:id="ex1012023-01-2014-17-31" part="I" next="ex001012025-09-1509-01-56" status="finalized">
                  <milestone unit="section" n="Cover page (1a)"/>
                  <pb n="1a"/>
                  <lb n="1a1"/>
        
          ||  <rs type="work" ref="db:4422" ana="corpusmd:named_reference">dpal 'khor lo bde mchog lU i pa'i bstod pa yid bzhin nor bu</rs>
                  <expan>bzhugs s+ho</expan> ||
               </seg>
            </ab>

            <ab xml:space="preserve" type="text_body">
               <seg type="shared" part="M" xml:id="ex001012025-09-1509-01-56" next="ex1012023-01-2014-22-39" status="reviewed">
                  <milestone unit="section" n="Body of the text (1b1–2a5)"/>
                  <milestone unit="section" n="1"/>
                  <pb n="1b"/>
                  <lb n="1b1"/>
                  <lg>
                     <l>gang gis 'khor ba'i nyaMs thag ni ||</l>
                     <l>dran pa bal gyis 'joMs mdzad cing ||</l>
                     <l>bla med <expan>byang chub</expan> thob mdzad pa ||</l>
                     <l>bla ma'i zhabs la <expan>phyag 'tshal lo</expan> ||
                     </l>
                  </lg>

                  <milestone unit="section" n="2"/>
                  <lg>
                     <l>skye med ngang mas thugs rje <expan>chen po</expan> yis ||</l>
                     <l>keng rus <note type="editorial">Kawasaki 2007 reads: <mentioned>keng</mentioned>
      <mentioned/>
      <mentioned>sdus</mentioned> and corrects to: <mentioned>keng</mentioned>
      <mentioned> rus</mentioned></note>
                     <lb n="1b2"/>
                     <expan>'jigs</expan> su rung pa'i gdan stengs su<note type="editorial"><mentioned>su</mentioned> is followed by a <mentioned>tsheg</mentioned> before the double <mentioned>shad</mentioned></note> ||</l>
                  <l>bdud 'dul hUM las <expan>khro bo</expan>'i sku sprul ba ||</l>
                  <l>
                     <rs type="deity">bcom ldan bde ba'i mchog</rs> la <expan>phyag 'tshal lo</expan> ||
                  </l>
               </lg>

               <milestone unit="section" n="3"/>
               <lg>
                  <l>chos dbyings rnaM dag 'gyur med <expan>nam mkha'</expan> la ||</l>
                  <l>mtshon pa'i skur bstan dpa' bo'i rgyan gyis spras ||</l>
                  <l>
                     <lb n="1b3"/>
 thabs dang <expan>shes rab</expan>
                     <expan>gnyis</expan> med rol ba mdzad ||</l>
                  <l>
                     <rs type="deity">bcom ldan bde ba'i mchog</rs> la <expan>phyag 'tshal lo</expan> ||
                  </l>
               </lg>

               <milestone unit="section" n="4"/>
               <lg>
                  <l>dpa' bo'i stang<note type="editorial">Kawasaki 2007 corrects to: <mentioned>stangs</mentioned></note> stabs khro bo 'jigs su rung ||</l>
                  <l>sgeg pa'i nyaMs can <expan>snogs</expan> rgyan gyis spras ||</l>
                  <l>
                     <expan>rgod dang</expan> mi sdug snying rjes zhi ba mdzad ||</l>
                  <l>
                     <lb n="1b4"/>
 'gal ba'i chos 'chang <rs type="deity">bde mchog</rs>
                     <expan>phyag 'tshal lo</expan> ||
                  </l>
               </lg>

               <milestone unit="section" n="5"/>
               <lg>
                  <l>gang la <expan>chags</expan> dang sdang ba mi mnga' yang ||</l>
                  <l>gang gis 'dul ba <choice>
                     <reg>de dang</reg>
                     <orig>‹de dang›</orig>
                  </choice> de'i sras ||</l>
               <l>
                  <expan>chags</expan> sogs <expan>nyon mongs</expan> kun tu zhi mdzad pa'i ||</l>
               <l>
                  <rs type="deity">bcom ldan bde ba'i mchog</rs> la <expan>phyag 'tshal lo</expan> ||
               </l>
            </lg>

            <milestone unit="section" n="6"/>
            <lg>
               <l>sgrib <expan>gnyis</expan>
                  <lb n="1b5"/>
 nyes pa'i rgyu <expan>tshogs</expan>
                  <expan>rnaM par</expan> <choice><reg>spangs</reg><orig>spang‹s›</orig></choice><note type="editorial">Kawasaki 2007 reads: <mentioned>sprangs</mentioned></note> ||</l>
               <l>
                  <expan>sdug bsngal</expan>
                  <expan>'bras bu'i</expan><note type="editorial">Kawasaki 2007 reads: <mentioned>'bras bu</mentioned></note>                  
                  <expan>tshogs</expan> dang bral ba nyid ||</l>
               <l>'khor dang <expan>mya ngan</expan> 'da'<note type="editorial">Kawasaki 2007 corrects to: <mentioned>'das</mentioned></note> la mi gnas pa'i ||</l>
               <l>
                  <expan>gnyis</expan> med <expan>ye shes</expan>
                  <rs type="deity">bde mchog</rs> la <expan>phyag 'tshal</expan> ||
               </l>
            </lg>

            <milestone unit="section" n="7"/>
            <lg>
               <l>dag pa chos sku'i sprul pa ni ||</l>
               <l>
                  <expan>dmigs</expan> pa med pa'i <lb n="1b6"/>
               <expan>thugs rje</expan> yis ||</l>
            <l>
               <expan>gzugs</expan> sku sgyu ma ltar ston pa ||</l>
            <l>
               <rs type="deity">rdo rje phag mo</rs>
               <expan>phyag 'tshal lo</expan> ||
            </l>
         </lg>

         <milestone unit="section" n="8"/>
         <lg>
            <l>
               <expan>ye shes</expan>
               <expan>bzhi</expan>'i ngo bo yi ||</l>
            <l>
               <rs type="deity">mkha' 'gro la ma dum skyes ma</rs> ||
            </l>
            <l>
               <rs type="deity">gzugs can ma</rs> dang thod pa <expan>bzhi</expan> ||
            </l>
            <l>
               <rs type="deity">bde chen 'khor lo</rs> phyag 'tshal lo ||</l>
         </lg>
         <note type="gloss">'khor lo gsum gyi *** rnaMs la bstod pa ni ||</note>

         <milestone unit="section" n="9"/>
         <lg>
            <l>
               <rs type="deity">rab tu gtum<note type="editorial">Kawasaki 2007 reads: <mentioned>stum</mentioned></note>
 mo</rs>
               <rs type="deity">gtuM mig <lb n="1b7"/>
 ma</rs> ||
            </l>
            <l>
               <rs type="deity">'od ldan sna tshogs<note type="editorial">Kawasaki 2007 corrects to: <mentioned>sna chen</mentioned></note></rs>
               <rs type="deity">brtan pa'i blo</rs> ||
            </l>
            <l>
               <rs type="deity">mi thung</rs>
               <rs type="deity">lang ka'i dbang phyug ma</rs> ||
            </l>
            <l>
               <rs type="deity">shing grib ma</rs> la <expan>phyag 'tshal lo</expan> ||
            </l>
         </lg>

         <milestone unit="section" n="10"/>
         <lg>
            <l>
               <rs type="deity">sa bsrungs ma</rs> dang <rs type="deity">'jigs byed che</rs> ||
            </l>
            <l>
               <rs type="deity">rlung shugs</rs>
               <rs type="deity">chang 'thung</rs>
               <rs type="deity">ljang lha mo</rs> ||
            </l>
            <l>
               <pb n="2a"/>
               <lb n="2a1"/>
               <rs type="deity">shin tu bzang mo</rs>
               <rs type="deity">rta sna mo</rs> ||
            </l>
            <l>
               <rs type="deity">bya gdong ma</rs> la <expan>phyag 'tshal</expan> lo ||</l>
         </lg>

         <milestone unit="section" n="11"/>
         <lg>
            <l>
               <rs type="deity">'khor shug<note type="editorial">Kawasaki 2007 corrects to: <mentioned>shugs</mentioned></note>
</rs>
               <rs type="deity">kha NDa ro ha</rs> dang ||</l>
            <l>
               <rs type="deity">chang 'thung</rs>
               <rs type="deity">go cha rab dpa' mo</rs> ||
            </l>
            <l>
               <rs type="deity">stobs chen 'khor lo bsgyur ma</rs> dang ||</l>
            <l>
               <rs type="deity">brtson chen ma</rs> la <expan>phyag 'tshal</expan> lo ||</l>
         </lg>
         <note type="gloss">dpa' ba rnaMs la bstod pa ni ||</note>

         <milestone unit="section" n="12"/>
         <lg>
            <l>
               <rs type="deity">thod pa'i <lb n="2a2"/>
 dum bu</rs>
               <rs type="deity">keng rus<note type="editorial">Kawasaki 2007 reads: <mentioned>sdus</mentioned></note>
 che</rs> ||
            </l>
            <l>
               <rs type="deity">keng rus<note type="editorial">Kawasaki 2007 reads: <mentioned>sdus</mentioned></note>
</rs>
               <rs type="deity">mche rtsigs lha'i sgra</rs> ||
            </l>
            <l>
               <rs type="deity">'od dpag med dang</rs>
               <rs type="deity">rdo rje'i 'od</rs> ||
            </l>
            <l>
               <rs type="deity">rdo rje sku</rs> la <expan>phyag 'tshal</expan> bstod ||</l>
         </lg>

         <milestone unit="section" n="13"/>
         <lg>
            <l>
               <rs type="deity">myu gu can</rs> dang <rs type="deity">ral pa can</rs> ||
            </l>
            <l>
               <rs type="deity">dpa' chen</rs>
               <rs type="deity">hUM mdzad</rs>
               <rs type="deity">rab tu bzang<note type="editorial">Misprint in Kawasaki 2007: <mentioned>bṇang</mentioned></note>
</rs> ||
            </l>
            <l>
               <rs type="deity">rdo rje bzang</rs> dang <lb n="2a3"/>
            <rs type="deity">'jigs byed che</rs> ||
         </l>
         <l>
            <rs type="deity">mig mi bzang</rs> la <expan>phyag 'tshal lo</expan> ||
         </l>
      </lg>

      <milestone unit="section" n="14"/>
      <lg>
         <l>
            <rs type="deity">stobs chen rin chen rdo rje</rs> dang ||</l>
         <l>
            <rs type="deity">rta mgrin mkha' snying he ru ka</rs> ||
         </l>
         <l>
            <rs type="deity">padma gar dbang rnaM snang</rs> dang ||</l>
         <l>
            <rs type="deity">rdo rje seMs</rs> la <expan>phyag 'tshal lo</expan> ||
         </l>
      </lg>
      <note type="gloss">sgo 'tshams ma brgyad la bstod pa ni ||</note>

      <milestone unit="section" n="15"/>
      <lg>
         <l>phyogs <expan>bzhi</expan>'i sgo rnaMs skyong mdzad <lb n="2a4"/>
 pa ||</l>
         <l>
            <rs type="deity">khwa gdong ma</rs> dang <rs type="deity">'ug gdong ma</rs> ||
         </l>
         <l>de <expan>bzhin</expan>
            <rs type="deity">khyi'i gdong ma</rs> dang ||</l>
         <l>
            <rs type="deity">phag gdong<note type="editorial">Kawasaki 2007 reads: <mentioned>phag dong</mentioned></note>
 ma</rs> la <expan>phyag 'tshal lo</expan> ||
         </l>
      </lg>

      <milestone unit="section" n="16"/>
      <lg>
         <l>
            <expan>gzugs</expan>
            <expan>gnyis</expan> kyis ni yid 'phrog ma ||</l>
         <l>
            <rs type="deity">brtan pa mo</rs> dang <rs type="deity">pho nya mo</rs> ||
         </l>
         <l>
            <rs type="deity">mche brtsigs ma</rs> dang <rs type="deity">'joMs ma</rs> dang ||</l>
         <l>
            <rs type="deity">gshin rje <lb n="2a5"/>
 bzhi</rs> la <expan>phyag 'tshal lo</expan> ||
         </l>
      </lg>
   </seg>
</ab>

