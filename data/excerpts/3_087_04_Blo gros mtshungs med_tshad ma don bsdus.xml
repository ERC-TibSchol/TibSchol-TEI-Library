            <lb edRef="inst:5293" n="61b3"/><seg type="excerpt" xml:id="ex87042023-10-04-135" status="finalized" ana="corpusmd:colophon">
         <milestone n="Colophon (61b3-61b6)" unit="section"/>
               <rs type="work" ana="corpusmd:named_reference" ref="db:5294">tshad ma'i don bsdus pa</rs> zhes bya ba'i bstan <choice><orig>bcas</orig><reg>bcos</reg></choice> 'di ni <lb edRef="inst:5293" n="61b4"/> lung dang <choice><orig>°igs</orig><reg>rigs</reg></choice> pa man ngag gyi tshul la dbang 'byor pa | mkhas <choice><orig>pa</orig><reg>pa'i</reg></choice> <expan>gtsug gi</expan> rgyan du gyur pa <note type="editorial">On f. 60a7: mkhas pa'i tsug rgyan phyogs kyi glang po </note> | phyogs ma lus par snyan pa rab tu <expan>grags</expan> pa can ¦ 'gran zla dang bral ba'i mkhas pa chen po <rs type="person" ana="corpusmd:named_reference" ref="db:4095">dbang phyug dpal</rs> <note type="editorial">There is a Sakya scholar of the 13th c. by this name (P3696)</note> gyi bka' drin pas rab tu byed pa <rs type="work" ana="corpusmd:unnamed_reference" ref="db:5633">sde bdun mdo</rs> dang bcas °°°° <note type="editorial"> Could be pa'i legs but unclear</note> par sbyor bas <choice><orig>rnams</orig><reg>rnam</reg></choice> spyod <lb edRef="inst:5293" n="61b5"/> °°°° rtog rig pa'i tshul khong du chud pa ¦ gzhung <expan>lugs</expan> la <rs type="person" ana="corpusmd:named_reference" ref="db:4094"><expan>chen po</expan> blo gros mtshungs med</rs> la don du gnyer ba'i slob ma blo gsal zhing yid gzhungs pa du mas yang dang yang du bskul zhing <rs type="person" ana="corpusmd:named_reference" ref="db:5957"><rs type="place" ana="corpusmd:named_reference" ref="db:5949">mnga' ris</rs> pa dge'i ba'i bshes | gnyen 'od zer seng ge</rs>s shog gu yang phul nas snar °°°°°°°° <lb edRef="inst:5293" n="61b6"/> kyis <rs type="place" ana="corpusmd:named_reference" ref="db:5733">dpal sa skya'i gtsug lag khang</rs> du legs par sbyar ba rdzogs s+ho || </seg>
