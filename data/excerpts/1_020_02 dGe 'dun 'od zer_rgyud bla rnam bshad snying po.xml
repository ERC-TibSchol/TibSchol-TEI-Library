   <standOff><listPerson><person xml:id="person3747"><persName type="main" xml:lang="bo-Latn-x-wylie">maitreya</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">'phags pa byams pa</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">byams pa mgon po</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">maitreyanātha</persName><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P6118</idno><idno type="APIS">3747</idno><note type="comment">Future Buddha held as the author of the works that come to be designated as the "Five Jewels of Maitreya" (ID:6167).</note></person><person xml:id="person3756"><persName type="main" xml:lang="bo-Latn-x-wylie">asaṅga</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">slob dpon thogs med</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">thogs myed</persName><sex value="M"/><nationality>Indic</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P6117</idno><idno type="APIS">3756</idno></person><person xml:id="person3786"><persName type="main" xml:lang="bo-Latn-x-wylie">rngog blo ldan shes rab</persName><persName xml:lang="bo">རྔོག་བློ་ལྡན་ཤེས་རབ</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">rngog lo tsA ba</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">lo chen</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">dge slong blo ldan shes rab</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">rngog lo rtsa ba</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">rngog dge slong blo ldan shes rab</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">blo ldan bzang po</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">lo tsha ba chen po</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">lo ts+tsha ba</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">lo tsha ba</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">lo tsa</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">rngog</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">blo ldan</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">ma hA</persName><birth notBefore="1059-01-01" notAfter="1059-12-31">1059</birth><death notBefore="1109-01-01" notAfter="1109-12-31">1109</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P2551</idno><idno type="APIS">3786</idno><note type="comment">See [BAQ9MH4T]: 193 for the main events of his life.&#13;
&#13;
Three manuscript editions of his writings and translations were deposited respectively in rNgog Blo ldan shes rab's tomb, in the monastery of gSang phu (probably in the main assembly hall), and in Drin las kyi sde (ID:4357) ([7FZ3B926]: 107).</note></person><person xml:id="person3868"><persName type="main" xml:lang="bo-Latn-x-wylie">pa tshab nyi ma grags</persName><persName xml:lang="bo">པ་ཚབ་ཉི་མ་གྲགས</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">pa tshab lo tsA ba nyi ma grags pa</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">zhang pa tshab nyi ma grags</persName><birth notBefore="1055-01-01" notAfter="1055-12-31">1055</birth><death notBefore="1141-01-01">after 1141</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P5651</idno><idno type="APIS">3868</idno><note type="comment">Proposed dates: c. 1070-1145.</note></person><person xml:id="person3910"><persName type="main" xml:lang="bo-Latn-x-wylie">dge 'dun 'od zer</persName><persName xml:lang="bo">དགེ་འདུན་འོད་ཟེར</persName><persName type="alt" xml:lang="bo-Latn-x-wylie">lha steng pa dge slong dge 'dun 'od zer</persName><birth notBefore="1400-01-01" notAfter="1500-12-31">after 1400 before 1500</birth><death notBefore="1519-01-01">after 1519</death><sex value="M"/><nationality>Tibetan</nationality><idno type="BDRC">https://purl.bdrc.io/resource/P2GS1016</idno><idno type="APIS">3910</idno><note type="comment">Author of two works on the Ratnagotravibhāga (ID:3749).</note></person></listPerson><listBibl><bibl xml:id="work3749"><title type="main" xml:lang="bo-Latn-x-wylie">ratnagotravibhāga</title><title type="alt" xml:lang="bo-Latn-x-wylie">rātnagotravibhāga mahāyānottaratantraśāstra</title><title type="alt" xml:lang="bo-Latn-x-wylie">uttaratantra</title><title type="alt" xml:lang="bo-Latn-x-wylie">theg pa chen po rgyud bla ma'i bstan bcos</title><author ref="person:3747">maitreya</author><author ref="person:3756">asaṅga</author><note type="isExtant">True</note><note type="comment">The authorship of the work comes to be ascribed to the future Buddha Maitreya (ID:3747) in the Indian tradition from the 11th c. onward and in the Tibetan tradition. On earlier witnesses ascribing the authorship to Sāramati or Sthiramati, see [BAQ9MH4T]: 20-27. No attribution of that work to Asaṅga (ID:3756) was located in Indian sources, but the colophon of the Tibetan translation by rNgog Blo ldan shes rab ascribes the verses to Maitreya and the prose commentary to Asaṅga ([BAQ9MH4T]: 27-28).&#13;
There are six Tibetan translations, only that by rNgog Blo ldan shes rab and Sajjana is currently extant ([BAQ9MH4T]: chap. 6).</note><idno type="APIS">3749</idno></bibl><bibl xml:id="work4621"><title type="main" xml:lang="bo-Latn-x-wylie">theg pa chen po rgyud bla ma'i rnam bshad don dam rnam nges bsdus pa'i snying po'i snying po</title><title xml:lang="bo">ཐེག་པ་ཆེན་པོ་རྒྱུད་བླ་མའི་རྣམ་བཤད་དོན་དམ་རྣམ་ངེས་བསྡུས་པའི་སྙིང་པོའི་སྙིང་པོ</title><textLang mainLang="bo"/><date type="composition" notBefore="1450-01-01" notAfter="1600-12-31">after 1450 before 1600</date><author ref="person:3910">dge 'dun 'od zer</author><note type="isExtant">True</note><note type="comment">According to the colophon, composed on "the fifth day of the waxing moon." The name of the year is unclear.</note><relatedItem type="commentaryOn" target="work:3749"/><idno type="APIS">4621</idno></bibl><bibl xml:id="work5217"><title type="main" xml:lang="bo-Latn-x-wylie">rgyud bla ma'i sa bcad mtshungs med legs bshad</title><title xml:lang="bo">རྒྱུད་བླ་མའི་ས་བཅད་མཚུངས་མེད་ལེགས་བཤད</title><title type="alt" xml:lang="bo-Latn-x-wylie">rgyud bla ma'i bsdus don gyi sa bcad sa ma Tig khyad 'phags mtshungs med legs bshad</title><title type="alt" xml:lang="bo-Latn-x-wylie">sa ma Tig</title><textLang mainLang="bo"/><date type="composition" notBefore="1421-01-01" notAfter="1482-12-31">after 1421 before 1482</date><author ref="person:3910">dge 'dun 'od zer</author><note type="isExtant">True</note><note type="comment">Topical outline of the Ratnagotravibhāga (ID:3749), with lemmata in interlinear notes in instance (ID:5216), "composed as a commentary" ((ID:5216), 1b3-4: sa bcad sa ma Tig 'di 'grel bzhin brtsams).&#13;
Date of composition: An iron ox (?) year, maybe 1421 or 1481.</note><idno type="APIS">5217</idno></bibl></listBibl><listPlace><place xml:id="place5559"><placeName xml:lang="bo-Latn-x-wylie">bod</placeName><placeName xml:lang="bo">བོད</placeName><placeName type="alt" xml:lang="bo">gangs ri'i khrod la kha ba can gyi ljongs</placeName><placeName type="alt" xml:lang="bo">ri bo gangs can</placeName><placeName type="alt" xml:lang="bo">gangs ri'i khrod</placeName><placeName type="alt" xml:lang="bo">gangs can</placeName><idno type="APIS">5559</idno></place><place xml:id="place5652"><placeName xml:lang="bo-Latn-x-wylie">rwa stod bde ba can</placeName><placeName xml:lang="bo">རྭ་སྟོད་བདེ་བ་ཅན</placeName><placeName type="alt" xml:lang="bo">chos gra chen po bde ba can</placeName><placeName type="alt" xml:lang="bo">rwa stod bde ba can</placeName><placeName type="alt" xml:lang="bo">mnyes thang bde ba can</placeName><placeName type="alt" xml:lang="bo">snye thang bde ba can</placeName><placeName type="alt" xml:lang="bo">rwa stod dgon</placeName><location><geo>29.5325 90.914722</geo></location><idno type="APIS">5652</idno></place><place xml:id="place5740"><placeName xml:lang="bo-Latn-x-wylie">rnam dag zhing</placeName><placeName xml:lang="bo">རྣམ་དག་ཞིང</placeName><idno type="APIS">5740</idno></place><place xml:id="place7404"><placeName xml:lang="bo-Latn-x-wylie">lha steng</placeName><placeName xml:lang="bo">ལྷ་སྟེང</placeName><idno type="APIS">7404</idno></place></listPlace><listRelation><relation xml:id="rel655" name="author-of" active="#person3910" passive="#work4621" type="positive"><desc>Evidence: <ptr target="#ex20022023-09-15-130857"/></desc></relation><relation xml:id="rel8222" name="quotes-with-name" active="#person3910" passive="#person3868" type="positive"/><relation xml:id="rel8221" name="quotes-with-name" active="#person3910" passive="#person3786" type="positive"/><relation xml:id="rel2023" name="active-at" active="#person3910" passive="#place5652" type="positive"/><rel