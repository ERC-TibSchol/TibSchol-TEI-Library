         <pb n="15a"/><seg type="shared" status="reviewed" part="M" next="ex58042024-12-0515-50-413"><lb n="15a4"/> zhes <expan>gsungs so</expan> ||
sngon sbyangs las kyi 'phro pad pas | rang gi mos pa mar ba'i rgyus || babbr
 gtam ngan khyad bsad nas ||
         bdag 'dzin 'dul ba'i gdam ga zhus ||
         da ni shi yang mi <expan>'gyod do</expan> || ces pa ni <expan>rnal 'byor</expan> kyi dam phyug chen po <rs type="person" ana="corpusmd:named_reference" ref="db:3874">'chad kha ba</rs>s <expan>thugs</expan>  <lb n="15a5"/> <expan>legs</expan> par sbyangs pas | bdag pas gzhan gces kyi thugs rang 'dod kyis khri ba gtan nas med pa skyes pa'i gden thob pa'i gsung yin no ||</seg>

    <pb n="15a"/><seg type="excerpt" xml:id="ex58042024-12-0515-50-413" status="finalized" part="I" next="ex58042024-12-0515-50-41"><milestone n="Closing verses" unit="section"/>
         <lg><l><rs type="person" ana="corpusmd:named_reference" ref="db:7022"><expan>grags</expan> pa'i mtshan can <note type="gloss">mkhan chen bsod naMs ra sa brag phug pa'i bsgoM chen po</note><note type="editorial">Reading "ra sa brag phug" tentative.</note> chos rje</rs>'i bka' drin las |</l>
         <l><expan>legs</expan> par rnyed pa'i snyan rgyud <expan>rin chen</expan> gter ||</l>
        <l> dad ldan <lb n="15a6"/> slob mas bskul nas phye ba'i mthus ||</l> 
         <l>'gro kun <expan>byang chub</expan> <expan>thugs</expan> 2 'byongs par shog ||</l></lg></seg>
         
        <pb n="15a"/><seg type="excerpt" xml:id="ex58042024-12-0515-50-41" status="finalized" ana="corpusmd:colophon" part="F"><milestone n="colophon" unit="section"/> 
       blo sbyong don bdun ma'i snyan brgyud tshig rnams | <expan>yi ge</expan> nyung du'i sgo nas dkrol ba 'di ||
         <rs type="person" ana="corpusmd:named_reference" ref="db:7021">theg pa <expan>mchog gi</expan> <expan>rnal 'byor</expan> pa <expan>grags</expan> pa rgyal mtshan</rs> gyis yang dag yang du bskul nas <rs type="person" ana="corpusmd:named_reference" ref="db:4066">btsun <lb n="15a7"/> pa thogs med</rs> kyis <rs type="place" ana="corpusmd:named_reference" ref="db:5692">chos <expan>rdzongs</expan></rs> <expan>su</expan> sbyar ba'o || shub+haM ||</seg>

