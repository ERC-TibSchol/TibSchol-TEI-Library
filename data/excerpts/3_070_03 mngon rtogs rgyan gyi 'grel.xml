         <ab xml:space="preserve"><gap reason="omitted"/><lb n="11b8"/><seg type="excerpt" xml:id="ex703-2024-10-04-15-42" status="finalized">
         'dus tshul la <rs type="person" ref="db:3786" ana="corpusmd:named_reference">lo tsha ba</rs> na re rgya che ba mkhyen 3 nang du rgya chung ba sbyor ba <expan>chos sku</expan> 'du ste rgya mtsho'i nang du chu'i thigs pa <expan>bzhin no</expan> <expan>gsung ngo</expan> || </seg>

         <lb n="11b8"/><seg type="excerpt" xml:id="ex703-2024-10-04-15-47" status="finalized">
         <rs type="person" ref="db:3809" ana="corpusmd:named_reference">dge bshes khyung <expan>rin chen</expan> grags</rs> na re 3 po spyi sbyor ba <expan>chos sku</expan> <expan>bye brag</expan> yin pa'i phyir || 
         </seg><gap reason="omitted"/><lb n="11b8"/><seg type="excerpt" xml:id="ex70032025-04-2417-51-04" status="finalized" part="M" next="ex070032025-10-0720-11-45">
       <milestone n="a. dge bshes 'bre" unit="section"/>
       <rs type="person" ana="corpusmd:named_reference" ref="db:3807"><expan>dge bshes</expan> <expan>'bre shes</expan> rab 'bar</rs> na re 3 pa rang <expan>bzhin</expan> <lb n="11b9"/> sbyor ba <expan>chos sku</expan> gnas skabs yin pa'i phyir rang <expan>bzhin</expan> gyi nang du gnas skabs 'dus te rig pa dang bde bsdug <expan>bzhin no</expan> || zer ba la mkhyen 3 gang mkhyen 3 tsaM mi skye <expan>med</expan> <choice><reg>mngon sum</reg><orig>mngon ‹3›</orig></choice> gyis rtogs pa'i mkhyen 3 yin | dang po mi rigs te <expan>thams cad</expan> <choice><reg>mkhyen</reg><orig>‹mkhyen›</orig></choice> pa nyid 3 gyi sgo nas ces bstod <expan>phyag gi</expan> sgor gsungs pa'i phyir ro ||</seg>
         
         <seg type="shared" xml:id="ex070032025-10-0720-11-45" status="reviewed" part="M" next="ex703-2024-10-04-15-53">gnyis pa'ang mi rigs te de gsum rgya che ba dang spyi dang rang bzhin ma yin te tshogs sbyor na med pa'i phyir ro ||</seg>

         
         <seg type="excerpt" xml:id="ex703-2024-10-04-15-53" status="finalized" part="M">     
         <pb n="11a'"/>
         <lb n="11a'1"/> 
         <milestone n="b. dge bshes ar" unit="section"/>
         yang <rs type="person" ref="db:3816" ana="corpusmd:named_reference"><expan>dge bshes</expan> ar</rs> na re bstod <expan>phyag gi</expan> yul nyungs skyon <expan>med</expan> de mkhyen 3 mtshon byed kyi chos suM bcus sbyor ba <expan>chos sku</expan> bsdus pa'i <expan>phyir ro</expan> zer ba yang ma yin te | chos suM bcu la bstod phyag byas pa <expan>med</expan> pa'i <expan>phyir ro</expan> ||</seg> 

